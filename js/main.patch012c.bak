try{ dexGot = new Set(JSON.parse(LS.get('dinodoku-dex')||'[]')); }catch(e){}
(function(){ const v=new Set(allMons().map(p=>p.id)); let ch=false; dexGot=new Set([...dexGot].filter(id=>{ if(v.has(id)) return true; ch=true; return false; })); if(ch){ LS.set('dinodoku-dex', JSON.stringify([...dexGot])); } })();
let dexTab='all';
function renderDex(){
  const grid=$('dex-grid'); if(!grid) return; grid.innerHTML='';
  allMons().forEach(p=>{
    const d=document.createElement('div');
    d.className='dex-cell p3d s'+(p.stars||1)+(dexGot.has(p.id)?' got':'');
    d.id='dex-'+p.id;
    d.innerHTML='<span class="nb">#'+p.id+'</span><img src="'+p.img+'" alt="'+p.name+'">';
    d.title = dexGot.has(p.id) ? p.name : '未捕獲';
    d.addEventListener('click', ()=>showDexDetail(p));
    grid.appendChild(d);
  });
  dexCount();
}
function dexCount(){
  const dc=$('dex-count'); if(!dc) return;
  const all=allMons();
  const done = dexGot.size>=all.length;
  dc.textContent = (done?'🎉 收藏完成！':'收藏 ')+dexGot.size+' / '+all.length;
}
function dexPoolByTab(){
  const all=allMons();
  if(dexTab==='gen1') return POKEMON;
  if(dexTab==='legend') return (typeof LEGENDS!=='undefined')?LEGENDS:[];
  return all;
}
function renderDexFull(){
  const grid=$('dexfull-grid'); grid.innerHTML='';
  const pool=dexPoolByTab();
  pool.forEach(p=>{
    const d=document.createElement('div');
    d.className='dex-cell p3d s'+(p.stars||1)+(dexGot.has(p.id)?' got':'');
    d.id='df-'+p.id;
    const rk=rarityOf(p.id);
    d.innerHTML='<span class="nb">'+RARITY_NAMES[rk]+'</span><img src="'+p.img+'" alt="'+p.name+'">';
    d.title=(dexGot.has(p.id)?RARITY_NAMES[rk]+' · '+p.name:'未捕獲 · '+RARITY_NAMES[rk]);
    d.addEventListener('click', ()=>showDexDetail(p));
    grid.appendChild(d);
  });
  const gotInPool=pool.filter(p=>dexGot.has(p.id)).length;
  $('dexfull-count').textContent='收藏 '+gotInPool+' / '+pool.length+'（全部 '+dexGot.size+' / '+allMons().length+'）'+(dexGot.size>=allMons().length?' 🎉 收藏完成！':'');
}
document.querySelectorAll('.dtab').forEach(b=>{
  b.onclick=()=>{
    document.querySelectorAll('.dtab').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');
    dexTab=b.dataset.t;
    renderDexFull();
    SFX.tap();
  };
});
let dexdMon=null;
function showDexDetail(p){
  dexdMon=p;
  const got = dexGot.has(p.id);
  const rk = rarityOf(p.id);
  const detailFx = [
    'drop-shadow(0 3px 5px rgba(43,91,45,.32)) saturate(1.02)',
    'drop-shadow(0 0 9px #42a5f5) saturate(1.08)',
    'drop-shadow(0 0 11px #ffb300) saturate(1.14)',
    'drop-shadow(0 0 13px #ff7043) drop-shadow(0 0 20px rgba(255,80,30,.55)) saturate(1.2)',
    'drop-shadow(0 0 10px #f3d36b) drop-shadow(0 0 22px #8b5cf6) saturate(1.28)'
  ];
  $('dexd-img').src = p.img;
  $('dexd-img').className = 'st'+(p.stars||1);
  $('dexd-img').style.filter = got ? detailFx[rk] : 'grayscale(1) opacity(.35)';
  $('dexd-img').style.transform = got ? 'scale('+[.94,1,1.05,1.1,1.16][rk]+')' : 'scale(.94)';
  $('dexd-name').textContent = got ? p.name : '？？？';
  $('dexd-sub').textContent = '#'+p.id+' · '+RARITY_BADGE[rk]+' '+RARITY_NAMES[rk]+' · '+(got ? '已收藏 ✅' : '尚未捕獲');
  const hab=$('dexd-hab');
  if((p.stars||1)>=3){
    const habs=habitatsOf(p.id);
    const known = got || HAB_REVEALED.has(p.id);
    hab.style.display='';
    hab.innerHTML = known
      ? '🗺️ <b>出沒區域：</b>'+habs.map(regionLabel).join('、')+'<br><small style="color:#a39483">在出沒區域出現機率 ×4！</small>'
      : '🗺️ <b>出沒區域：</b>？？？<br><small style="color:#a39483">聽隨行夥伴在首頁閒聊，可以打聽到情報…</small>';
  } else hab.style.display='none';
  const ex=$('dexd-extra');
  const bb=$('dexd-buddy');
  if(!got){
    ex.innerHTML='<div class="sub" style="text-align:center">捕獲後可設為隨行'+((p.stars||1)>=2?'、激發技能潛能':'')+'</div>'; bb.style.display='none';
    if((p.stars||1)>=3){
      const fg=fragOf(p.id);
      ex.insertAdjacentHTML('beforeend','<div class="skrow"><span>🧩 專屬碎片</span><span>'+fg+' / '+FRAG_NEED+(fg>=FRAG_NEED?' · 集滿自動召喚':'')+'</span></div>');
    }
  }
  else {
    const fr=frOf(p.id);
    const stars=p.stars||1;
    const skills=SK[p.id]||[];
    const slots=slotsOf(p.id);
    const innate=SKILLS.find(S=>S.id===innateSkillOf(p.id));
    const totalSlots=slots+(innate?1:0);
    const cost=awakenCostOf(p.id);
    const potential=potentialOf(p.id);
    let h='';
    h+='<div class="skrow"><span>🐾 友好度</span><span>'+fr+'%</span></div>';
    h+='<div class="frbar"><i style="width:'+fr+'%"></i></div>';
    if(stars>=2){
      h+='<div class="skrow"><span>⚡ 潛能值</span><span>'+potential+' / 100</span></div>';
      h+='<div class="frbar potential"><i style="width:'+potential+'%"></i></div>';
      h+='<div style="font-size:11px;color:#a39483;text-align:center">設為隨行並成功過關：潛能 +'+POTENTIAL_PER_WIN+'</div>';
    }
    h+='<div class="skrow"><span>⭐ 技能 '+((innate?1:0)+skills.length)+' / '+totalSlots+'</span><span>'+(BUDDY.id===p.id?'隨行中 🐾':'')+'</span></div>';
    if(stars===1){
      h+='<div class="sub" style="text-align:center;margin-top:8px">一星恐龍不帶技能</div>';
    } else {
      if(innate) h+='<div class="skrow"><span>✦ '+innate.n+'<br><small style="color:#a39483">'+innate.d+'</small></span><span class="tier t'+innate.t+'">天生</span></div>';
      skills.forEach((sk,index)=>{
        const S=SKILLS.find(x=>x.id===sk);
        if(S) h+='<div class="skrow"><span>'+S.n+'<br><small style="color:#a39483">'+S.d+'</small></span><span class="tier t'+S.t+'">'+SKILL_TIER_NAME[S.t]+'</span></div>';
      });
      for(let index=skills.length;index<slots;index++) h+='<div class="skrow"><span style="color:#b3a795">＋ 空白技能槽</span><span class="tier" style="background:#b3a795">待激發</span></div>';
      h+='<div style="font-size:12px;color:#8a7d6f;margin-top:8px">⚡ 可獲得'+skillRangeLabel(p.id)+' · 消耗 🌌 '+cost+'</div>';
      if(skills.length<slots){
        h+='<button class="awk-btn awaken-main" data-cost="'+cost+'" data-replace=""><b>🌌 '+cost+'</b>激發空白技能槽</button>';
      } else if(potential<100){
        h+='<div class="sub" style="text-align:center;margin-top:7px">技能槽已滿 · 潛能達到 100 可替換技能</div>';
      } else {
        h+='<div style="font-size:12px;color:#8a7d6f;margin-top:8px">潛能已滿！選擇要重塑的技能：</div><div class="awaken-tiers">';
        skills.forEach((sk,index)=>{
          const S=SKILLS.find(x=>x.id===sk);
          if(S) h+='<button class="awk-btn" data-cost="'+cost+'" data-replace="'+index+'"><b>🌌 '+cost+'</b>替換 '+S.n+'</button>';
        });
        h+='</div>';
      }
    }
    ex.innerHTML=h;
    if((p.stars||1)>=3){
      const fg=fragOf(p.id);
      ex.insertAdjacentHTML('beforeend','<div class="skrow"><span>🧩 專屬碎片</span><span>'+(got?fg+'（已擁有・無用）':fg+' / '+FRAG_NEED+(fg>=FRAG_NEED?' · 集滿自動召喚':''))+'</span></div>');
    }
    ex.querySelectorAll('.awk-btn').forEach(b=>{
      b.disabled = !ECON.devFree && (ECON.seeds||0) < +b.dataset.cost;
      b.onclick=()=>doAwaken(p.id, b.dataset.replace===''?null:+b.dataset.replace);
    });
    bb.style.display='';
    bb.textContent = (BUDDY.id===p.id) ? '解除隨行' : '🐾 設為隨行';
  }
  show('ov-dex');
}
$('dexd-buddy').onclick=()=>{
  if(!dexdMon) return;
  if(BUDDY.id===dexdMon.id){ BUDDY.id=0; }
  else { BUDDY.id=dexdMon.id; }
  LS.set('dinodoku-buddy', JSON.stringify(BUDDY));
  if(typeof renderBuddy==='function') renderBuddy();
  showDexDetail(dexdMon);
  SFX.catchp();
};
function doAwaken(id, replaceIndex=null){
  const stars=starsOf(id);
  const slots=slotsOf(id);
  if(stars<2 || slots===0){ SFX.wrong(); return; }
  const skills=SK[id]=SK[id]||[];
  const replacing=skills.length>=slots;
  if(replacing){
    if(potentialOf(id)<100){ floatText($('dexd-extra'),'潛能值尚未達到 100','#d64545'); SFX.wrong(); return; }
    if(!Number.isInteger(replaceIndex) || replaceIndex<0 || replaceIndex>=skills.length){ floatText($('dexd-extra'),'請選擇要替換的技能','#d64545'); SFX.wrong(); return; }
  } else replaceIndex=null;
  const blocked=new Set(skills);
  const innate=innateSkillOf(id);
  if(innate) blocked.add(innate);
  const pool=SKILLS.filter(skill=>skill.t<=maxSkillTierOf(id) && !blocked.has(skill.id));
  if(!pool.length){ floatText($('dexd-extra'),'目前沒有可替換的新技能','#d64545'); SFX.wrong(); return; }
  const cost=awakenCostOf(id);
  if(!ECON.devFree && (ECON.seeds||0)<cost){ floatText($('dexd-extra'),'星願種子不足','#d64545'); SFX.wrong(); return; }
  if(!ECON.devFree) ECON.seeds-=cost;
  const learned=pool[Math.floor(Math.random()*pool.length)];
  const oldSkill=replacing?SKILLS.find(skill=>skill.id===skills[replaceIndex]):null;
  if(replacing){
    skills[replaceIndex]=learned.id;
    POT[id]=0;
    potentialSave();
  } else skills.push(learned.id);
  skSave(); econSave(); econRender();
  if(typeof renderBuddySkills==='function') renderBuddySkills();
  SFX.catchp();
  alert(replacing
    ? '✨ 潛能重塑成功！\n「'+(oldSkill?oldSkill.n:'原技能')+'」替換為「'+learned.n+'」\n潛能值已歸零'
    : '✨ 潛能激發成功！\n學會了「'+learned.n+'」\n'+learned.d);
  if(dexdMon) showDexDetail(dexdMon);
}
$('dexd-close').onclick = ()=>hide('ov-dex');
function openDexFull(){ renderDexFull(); show('ov-dexfull'); SFX.tap(); }
$('menu-dex').onclick=()=>{ openDexFull(); };
$('btn-lv').onclick=()=>{ renderLV(); show('ov-lv'); SFX.tap(); };
$('lv-close').onclick=()=>hide('ov-lv');
$('menu-record').onclick=()=>{ renderLV(); show('ov-lv'); SFX.tap(); };
$('dexfull-close').onclick = ()=>hide('ov-dexfull');
$('dexfull-reset').onclick = ()=>{
  if(!confirm('確定要清空恐龍收藏嗎？（此動作無法復元）')) return;
  dexGot = new Set();
  LS.set('dinodoku-dex','[]');
  renderDexFull(); renderDex();
  SFX.wrong();
};
$('btn-dex').onclick = openDexFull;
function dexCollect(id){
  if(dexGot.has(id)) return false;
  
dexGot.add(id);

RECENT_DEX =
  RECENT_DEX.filter(
    x => x !== id
  );

RECENT_DEX.unshift(id);

RECENT_DEX =
  RECENT_DEX.slice(0,3);

LS.set(
  "dinodoku-recent",
  JSON.stringify(
    RECENT_DEX
  )
);

  LS.set('dinodoku-dex', JSON.stringify([...dexGot]));
  const el=$('dex-'+id);
  if(el){ el.classList.add('got','new'); setTimeout(()=>el.classList.remove('new'),1200); }
  dexCount();
  renderLiveDex();
  return true;
}

/* ---------- 新夥伴發現彈窗（星空風）：點擊畫面任意處回到遊戲 ---------- */
let nmQueue=[], nmOpen=false;
function queueNewMon(m){
  if(!m) return;
  nmQueue.push(m);
  if(!nmOpen) showNextNewMon();
}
function showNextNewMon(){
  const m=nmQueue.shift();
  if(!m){ nmOpen=false; return; }
  nmOpen=true;
  const rk=rarityOf(m.id);
  const im=$('nm-img');
  im.className='st'+(m.stars||1);
  im.src=m.img;
  $('nm-name').textContent='No.'+String(m.id).padStart(3,'0')+' '+m.name;
  $('nm-sub').textContent=RARITY_BADGE[rk]+' '+RARITY_NAMES[rk]+' · 繼續挑戰，收集更多恐龍吧！';
  show('ov-newmon');
  SFX.discover();
}
function closeNewMon(){
  if(!nmOpen) return;
  nmOpen=false;
  hide('ov-newmon');
  if(nmQueue.length) setTimeout(showNextNewMon, 280);
}
$('ov-newmon').addEventListener('click', closeNewMon);

/* ---------- 獎勵中心：六小遊戲（v2.0 patch2b） ---------- */
let GAME=null;
const G_TITLES={scratch:'🪙 刮刮樂',slot:'🎰 拉霸機',cards:'🃏 翻牌抽卡',wheel:'🎡 幸運輪盤',sil:'👤 猜剪影',tiles:'⛏ 尋寶九宮格'};

function wpick(arr,wf){
  const w=arr.map(wf); let s=w.reduce((a,b)=>a+b,0), r=Math.random()*s;
  for(let k=0;k<arr.length;k++){ r-=w[k]; if(r<=0) return arr[k]; }
  return arr[arr.length-1];
}
function prizeMonPool(){ return allMons().filter(p=>rarityOf(p.id)>=1 && !dexGot.has(p.id)); }
function rollMon(){
  /* v1.2.1：星數越多機率越低；棋盤格數越多、連勝越多 → 高星機率增加 */
  const N = G ? G.N : 6;
  const lvlBonus = Math.max(0, N-9);
  const streak = Math.min(20, ECON.streak||0);
  const W=[6, 3, 1.5, 0.7];
  return wpick(prizeMonPool(), p=>{
    const r=rarityOf(p.id);
    let w=W[r-1]||1;
    const lk=[0,0.18,0.30,0.45][r-1]||0;  /* 加成斜率：星越高吃越多 */
    const sk=[0,0.08,0.14,0.22][r-1]||0;
    w*= 1+lk*lvlBonus;
    w*= 1+sk*streak;
    if(N>=6 && habitatsOf(p.id).includes(N)) w*=4;  /* v1.2.1：出沒區域 ×4 */
    return w;
  });
}
/* 抽獎核心：16% 恐龍（稀有↑），其餘種子 1~5；luck1=星塵+1、luck2=必出恐龍（各消耗一次） */
function rollPrize(opt){
  opt=opt||{};
  let force=!!opt.forceMon;
  if(GAME && GAME.luck2){ force=true; GAME.luck2=false; }
  if(force || Math.random()<(opt.monC!=null?opt.monC:0.16)){
    const m=rollMon();
    if(m) return {type:'mon', mon:m};
  }
  const table=[1,1,1,2,2,2,3,3,4,5];
  let n=table[Math.floor(Math.random()*table.length)];
  if(GAME && GAME.luck1){ n+=1; GAME.luck1=false; }
  return {type:'seed', n:n};
}
function awardPrize(pz){
  if(!pz) return '';
  if(pz.type==='seed'){
    ECON.seeds=(ECON.seeds||0)+pz.n; econSave(); econRender();
    return '<div class="g-prize">🌌 ×'+pz.n+'<span class="g-sub">星願種子入袋！</span></div>';
  }
  const m=pz.mon;
  if(dexGot.has(m.id)){
    ECON.seeds=(ECON.seeds||0)+2; econSave(); econRender();
    return '<div class="g-prize"><img class="p3d" src="'+m.img+'" alt="">'+m.name+'<span class="g-sub">已擁有 → 轉為 🌌×2</span></div>';
  }
  dexCollect(m.id);
  SFX.catchp();
  return '<div class="g-prize"><img class="p3d" src="'+m.img+'" alt="">✨ '+m.name+'<span class="g-sub">'+RARITY_BADGE[rarityOf(m.id)]+' '+RARITY_NAMES[rarityOf(m.id)]+' · 加入圖鑑！</span></div>';
}
function startGame(g){
  if(!g || !G_TITLES[g]) return;
  if(!ECON.devFree){
    if((ECON.tickets||0)<1){ SFX.wrong(); floatText($('reward-games'),'沒有獎勵券了！過關可 +1 🎟','#d64545'); return; }
    ECON.tickets--; econSave();
  }
  GAME={cur:g, done:false, luck1:!!(ECON.luck&1), luck2:!!(ECON.luck&2)};
  ECON.luck=0; econSave(); econRender();
  GAME_BACK_MODE='reward';
  hide('ov-reward');
  $('game-title').textContent=G_TITLES[g];
  $('game-again').style.display='';
  $('game-again').disabled = !ECON.devFree && ECON.tickets<1;
  $('game-again').textContent = ECON.devFree ? '再玩一張 🎟（∞）' : '再玩一張 🎟（剩 '+ECON.tickets+'）';
  show('ov-game');
  ({scratch:gScratch,slot:gSlot,cards:gCards,wheel:gWheel,sil:gSil,tiles:gTiles})[g]();
}
function gameDone(html, good){
  if(GAME) GAME.done=true;
  $('game-area').insertAdjacentHTML('beforeend','<div class="g-done">'+html+'</div>');
  const ga=$('game-again');
  if(ga){ ga.style.display=''; ga.disabled = !ECON.devFree && (ECON.tickets||0)<1; ga.textContent = ECON.devFree ? '再玩一張 🎟（∞）' : '再玩一張 🎟（剩 '+(ECON.tickets||0)+'）'; }
  if(good!==false){ confetti(); SFX.win(); } else { SFX.miss(); }
}
/* 🪙 刮刮樂：canvas 銀膜刮除，>50% 自動揭曉 */
function gScratch(){
  const pz=rollPrize();
  const under = pz.type==='seed'
    ? '<div style="font-size:30px">🌌 ×'+pz.n+'</div>'
    : '<img class="p3d" src="'+pz.mon.img+'" style="width:76px;height:76px;object-fit:contain" alt=""><div style="font-size:16px">✨ '+pz.mon.name+'</div>';
  $('game-area').innerHTML='<div id="scratch-wrap"><div id="scratch-under">'+under+'</div><canvas id="scratch-cv" width="260" height="150"></canvas></div><div class="g-note">刮開銀膜看看獎品！（刮一半自動揭曉）</div>';
  const cv=$('scratch-cv');
  const tok=GAME;
  let revealed=false;
  const reveal=()=>{ if(revealed || GAME!==tok) return; revealed=true; cv.style.display='none'; gameDone(awardPrize(pz)); };
  const ctx = cv.getContext ? cv.getContext('2d') : null;
  if(!ctx){ setTimeout(reveal,500); return; }
  const gr=ctx.createLinearGradient(0,0,260,150);
  gr.addColorStop(0,'#cfd6de'); gr.addColorStop(.5,'#aab4bf'); gr.addColorStop(1,'#8d99a6');
  ctx.fillStyle=gr; ctx.fillRect(0,0,260,150);
  ctx.fillStyle='#66727e'; ctx.font='bold 16px sans-serif'; ctx.textAlign='center';
  ctx.fillText('🪙 刮這裡 🪙',130,82);
  let down=false, moves=0;
  const pt=e=>{ const r=cv.getBoundingClientRect(); return {x:(e.clientX-r.left)*(260/Math.max(1,r.width)), y:(e.clientY-r.top)*(150/Math.max(1,r.height))}; };
  const scratchAt=e=>{
    const p=pt(e);
    ctx.globalCompositeOperation='destination-out';
    ctx.beginPath(); ctx.arc(p.x,p.y,17,0,7); ctx.fill();
    if(++moves%6===0){
      const d=ctx.getImageData(0,0,260,150).data;
      let clear=0, tot=0;
      for(let k=3;k<d.length;k+=4*6){ tot++; if(d[k]<100) clear++; }
      if(clear/tot>0.5) reveal();
    }
  };
  cv.addEventListener('pointerdown',e=>{ down=true; scratchAt(e); });
  cv.addEventListener('pointermove',e=>{ if(down) scratchAt(e); });
  window.addEventListener('pointerup',()=>{ down=false; });
}
/* 🎰 拉霸機：三輪亂數滾動 → 定格中獎符號 */
function gSlot(){
  const pz=rollPrize();
  const syms=['🌌','🍒','⭐','🍀','⚡','🎁'];
  const finl=pz.type==='mon'?['🎁','🎁','🎁']:['🌌','🌌','🌌'];
  let h='<div class="slot-wrap">';
  for(let k=0;k<3;k++) h+='<div class="slot"><div class="reel" id="reel'+k+'">❔</div></div>';
  h+='</div><div class="g-note">轉吧轉吧～</div>';
  $('game-area').innerHTML=h;
  const tok=GAME;
  const iv=[0,1,2].map(k=>setInterval(()=>{ if(GAME!==tok){ clearInterval(iv[k]); return; } $('reel'+k).textContent=syms[Math.floor(Math.random()*syms.length)]; },70));
  [700,1150,1600].forEach((t,k)=>setTimeout(()=>{ if(GAME!==tok) return; clearInterval(iv[k]); $('reel'+k).textContent=finl[k]; SFX.tap(); },t));
  setTimeout(()=>{ if(GAME!==tok) return; gameDone(awardPrize(pz)); },2100);
}
/* 🃏 翻牌抽卡：五選二，2~3 張藏獎 */
function gCards(){
  const nP=Math.random()<0.4?3:2;
  const prizes=[];
  for(let k=0;k<nP;k++) prizes.push(rollPrize({monC:0.08}));
  while(prizes.length<5) prizes.push(null);
  for(let k=prizes.length-1;k>0;k--){ const j=Math.floor(Math.random()*(k+1)); const t=prizes[k]; prizes[k]=prizes[j]; prizes[j]=t; }
  const flipped=[]; let ended=false;
  const tok=GAME;
  let h='<div class="cards5">';
  for(let k=0;k<5;k++) h+='<div class="pcard" data-k="'+k+'"><div class="back">❓</div><div class="front"></div></div>';
  h+='</div><div class="g-note">五張牌翻兩張，看看藏了什麼！</div>';
  $('game-area').innerHTML=h;
  $('game-area').querySelectorAll('.pcard').forEach(el=>{
    el.onclick=()=>{
      const k=+el.dataset.k;
      if(ended || GAME.done || flipped.includes(k) || flipped.length>=2) return;
      flipped.push(k);
      el.classList.add('flip');
      const pz=prizes[k], fr=el.querySelector('.front');
      if(pz){
        fr.innerHTML = pz.type==='seed' ? '<span style="font-size:24px">🌌×'+pz.n+'</span>' : '<img class="p3d" src="'+pz.mon.img+'" alt=""><span>'+pz.mon.name+'</span>';
        SFX.tap();
      } else {
        el.classList.add('dud');
        fr.innerHTML='<span style="font-size:26px">💨</span><span>落空</span>';
        SFX.untap();
      }
      if(flipped.length>=2){
        ended=true;
        setTimeout(()=>{
          if(GAME!==tok) return;
          let html='', any=false;
          flipped.forEach(k2=>{ if(prizes[k2]){ html+=awardPrize(prizes[k2]); any=true; } });
          if(!any) html='<div class="g-prize">💨 兩張都落空…<span class="g-sub">下次會更好運！</span></div>';
          gameDone(html, any);
        },700);
      }
    };
  });
}
/* 🎡 幸運輪盤：八格 conic-gradient + 旋轉定格 */
function gWheel(){
  const segs=[{t:'🌌1',n:1},{t:'🌌2',n:2},{t:'🌌3',n:3},{t:'🌌1',n:1},{t:'🌌2',n:2},{t:'🌌5',n:5},{t:'✨',mon:true},{t:'🌌1',n:1}];
  let pick, pz;
  if(((GAME&&GAME.luck2)||Math.random()<0.16) && prizeMonPool().length){
    if(GAME) GAME.luck2=false;
    pick=6; pz={type:'mon', mon:rollMon()};
  } else {
    const order=[0,1,2,3,4,5,7];
    pick=wpick(order, i=>[3,2,1.2,3,2,.5,3][i]);
    let n=segs[pick].n;
    if(GAME && GAME.luck1){ n+=1; GAME.luck1=false; }
    pz={type:'seed', n:n};
  }
  const colors=['#ffe3d3','#fff8ef','#ffd9c2','#fff8ef','#ffe3d3','#fff8ef','#ffd166','#fff8ef'];
  let h='<div class="wheel-wrap"><div class="wheel-ptr">🔻</div><div id="wheel-disc"></div></div><div class="g-note">按下轉盤拼好運！✨ 格有機會是恐龍</div><div class="btns" style="justify-content:center"><button class="btn btn-primary" id="wheel-go">轉！🎡</button></div>';
  $('game-area').innerHTML=h;
  const disc=$('wheel-disc');
  const seg=360/8, conic=[];
  for(let k=0;k<8;k++) conic.push(colors[k]+' '+(k*seg)+'deg '+((k+1)*seg)+'deg');
  disc.style.background='conic-gradient('+conic.join(',')+')';
  for(let k=0;k<8;k++){
    const lab=document.createElement('div');
    lab.className='wlab'; lab.textContent=segs[k].t;
    lab.style.transform='translate(-50%,-50%) rotate('+(k*seg+seg/2)+'deg) translateY(-88px)';
    disc.appendChild(lab);
  }
  let spun=false;
  const tok=GAME;
  $('wheel-go').onclick=()=>{
    if(spun || (GAME&&GAME.done)) return;
    spun=true; SFX.tap();
    const center=pick*seg+seg/2;
    disc.style.transform='rotate('+(360*5+360-center)+'deg)';
    let fin=false;
    const done=()=>{ if(fin || GAME!==tok) return; fin=true; gameDone(awardPrize(pz)); };
    disc.addEventListener('transitionend',done,{once:true});
    setTimeout(done,3900);
  };
}
/* 👤 猜剪影：猜對直接帶走遠古/神話 */
function gSil(){
  let pool=prizeMonPool().filter(p=>rarityOf(p.id)>=2);
  if(!pool.length) pool=prizeMonPool();
  if(!pool.length){
    $('game-area').innerHTML='<div class="g-note">剪影大師的收藏已滿～直接送你小禮物！</div>';
    gameDone(awardPrize({type:'seed',n:2}));
    return;
  }
  const m=wpick(pool, p=>[1,2,4][rarityOf(p.id)-1]||1);
  const opts=[{n:m.name,ok:true}];
  const others=allMons().filter(p=>p.id!==m.id);
  let guard=0;
  while(opts.length<4 && guard++<500){
    const o=others[Math.floor(Math.random()*others.length)];
    if(!opts.find(x=>x.n===o.name)) opts.push({n:o.name,ok:false});
  }
  for(let k=opts.length-1;k>0;k--){ const j=Math.floor(Math.random()*(k+1)); const t=opts[k]; opts[k]=opts[j]; opts[j]=t; }
  let h='<span class="p3d silp"><img class="sil" src="'+m.img+'" alt="?"></span><div class="g-note">這是誰的剪影？猜對直接帶走牠！</div><div class="opts4">';
  opts.forEach((o,k)=>h+='<button class="opt4" data-k="'+k+'">'+o.n+'</button>');
  h+='</div>';
  $('game-area').innerHTML=h;
  let answered=false;
  $('game-area').querySelectorAll('.opt4').forEach(b=>{
    b.onclick=()=>{
      if(answered) return; answered=true;
      const o=opts[+b.dataset.k];
      if(o.ok){
        b.classList.add('ok');
        gameDone(awardPrize({type:'mon',mon:m}));
      } else {
        b.classList.add('no');
        ECON.seeds=(ECON.seeds||0)+1; econSave(); econRender();
        gameDone('<div class="g-prize">正確答案是 <b>'+m.name+'</b><span class="g-sub">沒猜中…安慰獎 🌌×1</span></div>',false);
      }
    };
  });
}
/* ⛏ 尋寶九宮格：翻格累積種子，⚡ 歸零，最多 3 格 */
function gTiles(){
  const vals=[1,1,1,1,1,2,2,'zap','zap'];
  for(let k=vals.length-1;k>0;k--){ const j=Math.floor(Math.random()*(k+1)); const t=vals[k]; vals[k]=vals[j]; vals[j]=t; }
  let bank=0, flips=0, ended=false;
  let h='<div class="gbank" id="tile-bank">目前 🌌 ×0</div><div class="tiles9">';
  for(let k=0;k<9;k++) h+='<div class="tile9" data-k="'+k+'">⛏</div>';
  h+='</div><div class="btns" style="justify-content:center"><button class="btn btn-primary" id="tile-stop" style="display:none">收手領取 💰</button></div><div class="g-note">翻開寶藏格累積種子；翻到 ⚡ 全部溜走！最多翻 3 格</div>';
  $('game-area').innerHTML=h;
  const upd=()=>{ $('tile-bank').textContent='目前 🌌 ×'+bank; };
  const tok=GAME;
  $('game-area').querySelectorAll('.tile9').forEach(el=>{
    el.onclick=()=>{
      const k=+el.dataset.k;
      if(ended || GAME.done || el.classList.contains('open')) return;
      el.classList.add('open');
      const v=vals[k];
      if(v==='zap'){
        ended=true;
        el.classList.add('bad'); el.textContent='⚡';
        bank=0; upd();
        $('tile-stop').style.display='none';
        gameDone('<div class="g-prize">⚡ 觸電了！<span class="g-sub">種子全部溜走…</span></div>',false);
      } else {
        bank+=v; flips++; upd();
        el.textContent='🌌'+(v>1?'×'+v:'');
        SFX.tap();
        if(flips>=3){
          ended=true;
          $('tile-stop').style.display='none';
          setTimeout(()=>{ if(GAME!==tok) return; gameDone(awardPrize({type:'seed',n:bank})); },450);
        } else {
          $('tile-stop').style.display='';
        }
      }
    };
  });
  $('tile-stop').onclick=()=>{
    if(ended || bank<=0) return;
    ended=true;
    gameDone(awardPrize({type:'seed',n:bank}));
  };
}

/* 獎勵中心開關 */
let GAME_BACK_MODE='reward';
function gameBackDefault(){
  hide('ov-game'); GAME=null; econRender();
  if(GAME_BACK_MODE==='story'){ GAME_BACK_MODE='reward'; openMenu(); }
  else show('ov-reward');
}
$('menu-reward').onclick=()=>{ econRender(); show('ov-reward'); SFX.tap(); };
$('reward-close').onclick=()=>hide('ov-reward');
document.querySelectorAll('#reward-games .rg-btn').forEach(b=>{ b.onclick=()=>startGame(b.dataset.g); });
$('game-back').onclick=gameBackDefault;
$('game-again').onclick=()=>{ if(GAME) startGame(GAME.cur); };

/* ---------- 寶箱系統：鐵箱／黃金寶箱／白金寶箱 ＋ 恐龍碎片召喚 ---------- */
const CHEST_DEFS = {
  iron: { n:'鐵箱',     e:'🗝️', w:{stone:45, seeds:35, book:12, frag:8},  seedR:[3,5],   fragN:1 },
  gold: { n:'黃金寶箱', e:'🌟', w:{stone:15, seeds:40, book:20, frag:25}, seedR:[8,15],  fragN:2 },
  plat: { n:'白金寶箱', e:'💠', w:{stone:0,  seeds:35, book:25, frag:40}, seedR:[20,30], fragN:3 },
};
const FRAG_NEED = 5; /* 專屬碎片集滿 5 片召喚（三星以上恐龍） */
let FRAG = {}; /* monId -> 碎片數 */
try{ FRAG = JSON.parse(LS.get('dinodoku-frag')||'{}')||{}; }catch(e){ FRAG={}; }
FRAG = Object.fromEntries(Object.entries(FRAG).filter(([id])=>MON_BY_ID[id] && starsOf(id)>=3));
function fragSave(){ LS.set('dinodoku-frag', JSON.stringify(FRAG)); }
fragSave();
function fragOf(id){ return FRAG[id]||0; }
function ri(a,b){ return a+Math.floor(Math.random()*(b-a+1)); }

/* 透背寶箱：背板半透明，看得到底下格線與盤面色塊 */
function chestSvgFor(tier){
  const C = {
    iron: {bd:'#8d99a6', dk:'#57616c', lt:'#c2ccd6', gl:'rgba(194,204,214,.36)'},
    gold: {bd:'#eab234', dk:'#9c6d0e', lt:'#ffe08a', gl:'rgba(255,224,138,.38)'},
    plat: {bd:'#c9d6e2', dk:'#8296a9', lt:'#f2f7fc', gl:'rgba(242,247,252,.46)'},
  }[tier] || {bd:'#8d99a6', dk:'#57616c', lt:'#c2ccd6', gl:'rgba(194,204,214,.36)'};
  const spark = tier==='plat' ? '<path d="M14 6 l1.6 3.2 3.2 1.6 -3.2 1.6 -1.6 3.2 -1.6-3.2 -3.2-1.6 3.2-1.6 z" fill="#fff" opacity=".9"/><path d="M51 9 l1.2 2.4 2.4 1.2 -2.4 1.2 -1.2 2.4 -1.2-2.4 -2.4-1.2 2.4-1.2 z" fill="#fff" opacity=".75"/>' : '';
  return '<svg viewBox="0 0 64 56" aria-hidden="true">'
    +'<ellipse cx="32" cy="52" rx="23" ry="3.6" fill="rgba(0,0,0,.18)"/>'
    +'<rect x="9" y="24" width="46" height="22" rx="5" fill="'+C.gl+'" stroke="'+C.lt+'" stroke-width="1.6"/>'
    +'<path d="M20.3 24v22M32 24v22M43.7 24v22M9 35h46" stroke="rgba(255,255,255,.55)" stroke-width="1.2" fill="none"/>'
    +'<rect x="5" y="22" width="6" height="26" rx="2.5" fill="'+C.bd+'" stroke="'+C.dk+'" stroke-width="1.2"/>'
    +'<rect x="53" y="22" width="6" height="26" rx="2.5" fill="'+C.bd+'" stroke="'+C.dk+'" stroke-width="1.2"/>'
    +'<rect x="5" y="42" width="54" height="7.5" rx="3" fill="'+C.bd+'" stroke="'+C.dk+'" stroke-width="1.2"/>'
    +'<path d="M6 27 Q6 12 32 12 Q58 12 58 27 Z" fill="'+C.bd+'" stroke="'+C.dk+'" stroke-width="1.4"/>'
    +'<rect x="5" y="23.5" width="54" height="5" rx="2.5" fill="'+C.dk+'"/>'
    +'<rect x="28" y="20" width="8" height="10" rx="2" fill="'+C.lt+'" stroke="'+C.dk+'" stroke-width="1.2"/>'
    +'<circle cx="32" cy="26.5" r="1.6" fill="'+C.dk+'"/>'
    +spark
    +'</svg>';
}

/* 開局：在「保證沒有恐龍」的格子藏寶箱（教學盤不放，不打擾教學） */
function placeChests(){
  const N = G.N;
  const cnt = N>=12 ? 3 : (N>=8 ? 2 : (N>=6 ? 1 : 0));
  if(!cnt) return;
  const pool = [];
  for(let i=0;i<N*N;i++) if(!G.catUnion.has(i)) pool.push(i);
  shuffle(pool);
  const w = N>=10 ? {iron:55, gold:32, plat:13} : {iron:68, gold:26, plat:6};
  for(let k=0;k<cnt && k<pool.length;k++){
    G.cells[pool[k]].chest = wpick(['iron','gold','plat'], t=>w[t]);
  }
}

/* 結算時逐箱抽獎並立刻套用獎勵（之後的動畫只是揭示，避免玩家跳過漏領） */
function rollChest(tier){
  const d = CHEST_DEFS[tier];
  const type = wpick(['stone','seeds','book','frag'], t=>d.w[t]);
  if(type==='stone') return {type, n:1};
  if(type==='seeds') return {type, n:ri(d.seedR[0], d.seedR[1])};
  if(type==='book')  return {type, n:1};
  const mons = allMons().filter(p=>(p.stars||1)>=3);
  const mon = wpick(mons, p=>dexGot.has(p.id)?1:6); /* 偏好還沒擁有的 */
  return {type, n:d.fragN, mon};
}
function applySkillBook(){
  const id = BUDDY.id;
  if(id && starsOf(id)>=2){
    const skills = SK[id] = SK[id]||[];
    const innate = innateSkillOf(id);
    if(skills.length < slotsOf(id)){
      const blocked = new Set(skills); if(innate) blocked.add(innate);
      const pool = SKILLS.filter(s=>s.t===0 && !blocked.has(s.id)); /* 一星技能書 */
      if(pool.length){
        const learned = pool[Math.floor(Math.random()*pool.length)];
        skills.push(learned.id); skSave();
        if(typeof renderBuddySkills==='function') renderBuddySkills();
        return {main:{icon:'📕', text:MON_BY_ID[id].name+' 學會「'+learned.n+'」', cls:'pos'}};
      }
    }
  }
  ECON.seeds = (ECON.seeds||0)+15;
  return {main:{icon:'📕', text:'技能書無法使用 → 折算 🌌×15', cls:'dim'}};
}
function applyChestItem(it){
  if(it.type==='stone') return {main:{icon:'🪨', text:'無用的石頭…', cls:'dim'}};
  if(it.type==='seeds'){ ECON.seeds=(ECON.seeds||0)+it.n; return {main:{icon:'🌌', text:'星願種子 ×'+it.n, cls:'pos'}}; }
  if(it.type==='book')  return applySkillBook();
  if(dexGot.has(it.mon.id)){
    return {main:{icon:'🧩', text:it.mon.name+' 碎片 ×'+it.n+'（已擁有・無用）', cls:'dim'}};
  }
  FRAG[it.mon.id] = fragOf(it.mon.id)+it.n; fragSave();
  const out = {main:{icon:'🧩', text:it.mon.name+' 碎片 ×'+it.n, cls:'pos'}};
  if(fragOf(it.mon.id)>=FRAG_NEED){
    FRAG[it.mon.id] = Math.max(0, fragOf(it.mon.id)-FRAG_NEED); fragSave();
    dexCollect(it.mon.id);
    out.extra = {icon:'✨', text:'碎片召喚成功！'+it.mon.name+' 加入圖鑑', cls:'pos'};
  }
  return out;
}
function chestRollAll(){
  const out = {rows:'', list:[]};
  if(!G.chests || !G.chests.length) return out;
  G.chests.forEach(tier=>{
    const r = applyChestItem(rollChest(tier));
    out.list.push({tier, evt:r.main});
    out.rows += '<div class="row"><span>'+CHEST_DEFS[tier].e+' '+CHEST_DEFS[tier].n+'</span><span class="'+r.main.cls+'">'+r.main.icon+' '+r.main.text+'</span></div>';
    if(r.extra) out.rows += '<div class="row"><span></span><span class="'+r.extra.cls+'">'+r.extra.icon+' '+r.extra.text+'</span></div>';
  });
  return out;
}

/* 結算面板：本局捕獲圖示列 + 寶箱逐一彈開揭示 */
function chestStripAnimate(list, caught){
  const box = $('res-chests'); if(!box) return;
  box.innerHTML=''; box.style.display='';
  if(caught && caught.length){
    const g = document.createElement('div');
    g.className = 'res-get';
    g.innerHTML = '<span class="rg-label">本局捕獲</span>'+caught.map(p=>'<img src="'+p.img+'" title="'+p.name+'" alt="'+p.name+'">').join('');
    box.appendChild(g);
  }
  if(!list.length){ if(!(caught&&caught.length)) box.style.display='none'; return; }
  list.forEach((it,k)=>{
    const card = document.createElement('div');
    card.className = 'chest-card';
    card.innerHTML = '<div class="chest-ico">'+chestSvgFor(it.tier)+'</div>'
      +'<div class="chest-prize"><span class="pz-ico">'+it.evt.icon+'</span> <span class="pz-tx '+it.evt.cls+'">'+it.evt.text+'</span></div>';
    box.appendChild(card);
    setTimeout(()=>{ card.classList.add('open'); SFX.bonus(); }, 450+k*620);
  });
}
/* ---------- 控制按鈕 ---------- */
$('btn-clear').onclick = ()=>{
  if(!G || G.state!=='marking' || G.tutorial) return;
  G.cells.forEach((c,i)=>{ c.mark=''; cellEls[i].classList.remove('x'); });
  updateCounts(); updateStatus();
};
let hintBusy=false;
function spawnCatchText(el, isFive){
  const s=document.createElement('span');
  s.className='newcatch'+(isFive?' five':'');
  s.textContent = isFive ? '★★★★★ 王者降臨!' : '新捕獲!';
  el.appendChild(s);
  setTimeout(()=>s.remove(), isFive?3600:1250);
}
$('btn-ball').onclick = ()=>{
  if(!G || G.state!=='marking' || G.balls<=0) return;
  if(TUT.expect){
    if(TUT.expect.type==='ballbtn'){ const f=TUT.expect.fn; clearExpect(); f(); }
    else tutNudge();
    return;
  }
  setBallMode(!G.ballMode);
  SFX.ball();
};
function updateHintBtn(){
  const b=$('btn-hint'); if(!b) return;
  const can = G && G.state==='marking' && !G.tutorial && (ECON.devFree||(ECON.seeds||0)>0) && !hintBusy;
  b.disabled = !can;
  b.textContent = '提示 🌿 '+(ECON.devFree?'🌌∞':'🌌'+(ECON.seeds||0));
}
function freeHint(){ /* 種子提示／技能提示共用：免費、不扣時間 */
  if(!G || G.state!=='marking') return null;
  const cands=[...G.cats].filter(i=>!G.cells[i].revealed);
  if(!cands.length) return null;
  const xCats=cands.filter(i=>G.cells[i].mark==='x');
  const unmarked=cands.filter(i=>!G.cells[i].mark);
  const hp = xCats.length?xCats:(unmarked.length?unmarked:cands);
  return hp[Math.floor(Math.random()*hp.length)];
}
function showHintAt(i){
  SFX.hint();
  hintBusy=true;
  updateHintBtn();
  const g=document.createElement('div');
  g.className='grass';
  g.innerHTML='<i>🌿</i><i>🌿</i><i>🌿</i><i>🌿</i><i>🌿</i>';
  cellEls[i].appendChild(g);
  setTimeout(()=>{ g.remove(); hintBusy=false; updateHintBtn(); }, 3000);
}
$('btn-giveup').onclick = ()=>{
  if(!G) return;
  if(!confirm('放棄這一局？')) return;
  ECON.streak=0; econSave();
  G.state='done'; timerStop(); stopBuddyTimers();
  hide('ov-loading'); hide('ov-genfail');
  openMenu(); SFX.tap();
};
$('btn-restart').onclick = ()=>{
  if(!G) return;
  if(!confirm('重新開始這一局？')) return;
  const n=G.N; G.state='done'; timerStop(); stopBuddyTimers();
  hide('ov-loading'); hide('ov-genfail');
  newRun(n); SFX.tap();
};
$('btn-hint').onclick = ()=>{
  if(!G || G.state!=='marking' || G.tutorial || hintBusy) return;
  if(!ECON.devFree && (ECON.seeds||0)<1){ SFX.wrong(); floatText($('btn-hint'),'需要 1 顆星願種子 🌌','#d64545'); return; }
  const i=freeHint();
  if(i===null) return;
  if(!ECON.devFree){ ECON.seeds--; }
  econSave(); econRender();
  showHintAt(i);
  const g=document.createElement('div');
  g.className='grass';
  g.innerHTML='<i>🌿</i><i>🌿</i><i>🌿</i><i>🌿</i><i>🌿</i>';
  cellEls[i].appendChild(g);
  setTimeout(()=>{ g.remove(); hintBusy=false; }, 3000);
};

function checkBallEnd(){
  if(G.found>=G.N){ G.state='ending'; timerStop(); setTimeout(winRound,850); return true; }
  if(G.balls<=0){ G.state='ending'; timerStop(); setTimeout(failRound,850); return true; }
  return false;
}

function winRound(){
  G.state='done'; G.lastFail=false;
  timerStop();
  SFX.win(); confetti();
  const chests=chestRollAll();
  $('res-emoji').textContent='🏆';
  $('res-title').textContent='過關！';
  if(G.tutorial){
    tutHide();
    $('res-sub').textContent = G.tutorial==='demo'
      ? '流程就是：✕ 排除 → 鎖定唯一候選 → 丟球捕獲。換你上場！'
      : '你已經獨立完成一局，規則都學會了！6×6 起加入沙漏計時：每抓一隻 +30 秒！';
    let bd='';
    bd+=row('🎯 捕獲恐龍', G.found+' / '+G.N, '', '');
    if(G.potentialReward) bd+=row('⚡ 隨行潛能', '+'+G.potentialReward.gain, G.potentialReward.value+' / 100', 'pos');
    $('res-breakdown').innerHTML=bd;
    if(G.tutorial==='demo'){ progUnlock(5); G.nextMode='guided5'; $('res-next').textContent='去 5×5 引導 ▶'; }
    else { progUnlock(6); G.nextMode='size6'; $('res-next').textContent='去 6×6 挑戰 ▶'; }
    $('res-lv').style.display='none';
    show('ov-result');
    chestStripAnimate([], null);
    return;
  }
  ECON.tickets=(ECON.tickets||0)+1; econSave(); econRender();
  progUnlock(G.N+1);
  const sc=Math.max(0, Math.floor(TIMER.left));
  const rec=lvRec(G.N);
  rec.best=Math.max(rec.best||0, sc);
  rec.total=(rec.total||0)+sc;
  LV[String(G.N)]=rec;
  lvSave();
  updateHUD(); renderLV();
  $('res-sub').textContent='剩餘 '+fmtSec(sc)+' 全部換算成你的分數！';
  let bd='';
  bd+=row('🎯 捕獲恐龍', G.found+' / '+G.N, '', '');
  bd+=chests.rows;
  bd+=row('🎟 獎勵券', '+1', '累積 '+ECON.tickets+' 張', 'pos');
  if(G.potentialReward) bd+=row('⚡ 隨行潛能', '+'+G.potentialReward.gain, G.potentialReward.value+' / 100', 'pos');
  bd+=row('⏳ 剩餘秒數', sc+' 秒', '+'+sc, 'pos');
  bd+=row('⏱ LV'+G.N+' 個人累積', rec.total, '', '');
  bd+='<div class="row" style="border-top:1px dashed #ddd0ba;margin-top:6px;padding-top:6px"><span><b>個人總分</b></span><span><b>'+fmtSec(lvTotal())+'</b></span></div>';
  $('res-breakdown').innerHTML=bd;
  $('res-next').textContent='下一局 ▶';
  setupResSel();
  show('ov-result');
  chestStripAnimate(chests.list, G.caughtMons);
}

function failRound(){
  G.state='done'; G.lastFail=true;
  ECON.streak=0; econSave();
  timerStop();
  const chests=chestRollAll();
  G.cells.forEach((c,i)=>{ if(c.cat && !c.revealed) cellEls[i].classList.add('ghost'); });
  SFX.fail();
  const left = G.N-G.found;
  $('res-emoji').textContent='😿';
  $('res-title').textContent='遊戲結束';
  $('res-sub').textContent='捕捉器用完了，還有 '+left+' 隻恐龍沒找到（位置已揭示）';
  let bd='';
  bd+=row('🎯 捕獲恐龍', G.found+' / '+G.N, '+0', '');
  bd+=chests.rows;
  bd+='<div class="row" style="border-top:1px dashed #ddd0ba;margin-top:6px;padding-top:6px"><span><b>個人總分</b></span><span><b>'+fmtSec(lvTotal())+'</b></span></div>';
  $('res-breakdown').innerHTML=bd;
  $('res-next').textContent='再挑戰一局';
  setupResSel();
  show('ov-result');
  chestStripAnimate(chests.list, G.caughtMons);
}

function row(a,b,c,cls){ return '<div class="row"><span>'+a+'（'+b+'）</span><span class="'+cls+'">'+c+'</span></div>'; }

$('res-next').onclick = ()=>{
  hide('ov-result');
  if(G.nextMode==='guided5'){ newRun(5); return; }
  if(G.nextMode==='size6'){ newRun(6); return; }
  if(G.lastFail){ G.round=1; } else { G.round++; }
  newBoard();
  startBuddyTimers();
};
$('res-menu').onclick = ()=>{ hide('ov-result'); openMenu(); };
$('res-reward').onclick = ()=>{ hide('ov-result'); econRender(); show('ov-reward'); SFX.tap(); };
$('res-rest').onclick = ()=>{
  hide('ov-result');
  timerStop();
  $('rest-sub').innerHTML = '個人總分 <b>'+lvTotal()+'</b> · 圖鑑收藏 <b>'+dexGot.size+' / '+allMons().length+'</b> · 星願種子 <b>🌌'+(ECON.devFree?'∞':(ECON.seeds||0))+'</b><br>明天再來挑戰！';
  show('ov-rest');
  SFX.win();
};
$('rest-menu').onclick = ()=>{ hide('ov-rest'); openMenu(); };
function setupResSel(){
  const sel=$('res-lv');
  sel.innerHTML='';
  const names={6:'新手',7:'新手',8:'新手',9:'學徒',10:'學徒',11:'大師',12:'菁英',13:'傳奇',14:'神話'};
  const maxN=Math.min(14, PROG.max||4);
  for(let n=6;n<=maxN;n++){
    const o=document.createElement('option');
    o.value=n; o.textContent='LV'+n+' · '+names[n]+' ⏱'+n+':00';
    if(G && G.N===n) o.selected=true;
    sel.appendChild(o);
  }
  sel.style.display='';
}
$('res-lv').addEventListener('change', ()=>{ hide('ov-result'); newRun(+$('res-lv').value); });
$('genfail-retry').onclick = ()=>{ hide('ov-genfail'); newBoard(); };
$('genfail-menu').onclick = ()=>{ hide('ov-genfail'); openMenu(); };

/* ---------- 教學引擎 ---------- */
function tutShow(html, btnLabel){
  $('tut-text').innerHTML = html;
  const b=$('tut-btn');
  if(btnLabel){ b.style.display=''; b.textContent=btnLabel; } else b.style.display='none';
  $('tutbar').classList.add('show');
}
function tutHide(){
  $('tutbar').classList.remove('show');
  clearExpect();
}
let tutRings=[];
function tutRing(cells){
  (Array.isArray(cells)?cells:[cells]).forEach(i=>{
    cellEls[i].classList.add('tut-ring');
    tutRings.push(i);
  });
}
function tutClearRings(){
  tutRings.forEach(i=>{ if(cellEls[i]) cellEls[i].classList.remove('tut-ring'); });
  tutRings=[];
  $('board').classList.remove('tut-focus');
  $('btn-ball').classList.remove('tut-btn-ring');
}
function tutFocus(on){ $('board').classList.toggle('tut-focus', !!on); }
function clearExpect(){
  TUT.expect=null;
  tutClearRings();
  tutFocus(false);
}
function tutNudge(){
  SFX.tap();
  const t=$('tut-text');
  t.classList.remove('tut-wiggle'); void t.offsetWidth; t.classList.add('tut-wiggle');
}
function waitBtn(){
  return new Promise(res=>{
    $('tut-btn').onclick = ()=>{ $('tut-btn').onclick=null; res(); };
  });
}
function waitCells(cells){ /* 等玩家把指定格全部 ✕（任一順序），走正常點擊流程 */
  return new Promise(res=>{
    const set=new Set(cells);
    const handler=(i)=>{
      markToggle(i);
      set.delete(i);
      if(!set.size){ clearExpect(); res(); }
      else {
        tutClearRings(); tutRing([...set]); tutFocus(true);
        TUT.expect={ type:'cell', cells:set, fn:handler };
      }
    };
    TUT.expect={ type:'cell', cells:set, fn:handler };
    tutRing([...set]); tutFocus(true);
  });
}
function waitCellClick(cells){
  return new Promise(res=>{
    TUT.expect={ type:'cell', cells:new Set(Array.isArray(cells)?cells:[cells]), fn:(i)=>res(i) };
    tutRing(cells); tutFocus(true);
  });
}
function waitBall(on){
  return new Promise(res=>{
    TUT.expect={ type:'ballbtn', fn:()=>{ setBallMode(on); res(); } };
    $('btn-ball').classList.add('tut-btn-ring');
    tutFocus(true);
  });
}
function demoMark(i){ /* 自動 ✕ */
  const c=G.cells[i];
  if(c.mark==='x'||c.revealed) return;
  c.mark='x';
  cellEls[i].classList.add('x','autoflash');
  setTimeout(()=>cellEls[i].classList.remove('autoflash'),450);
  SFX.tap();
  updateStatus();
}
function demoAlive(){ return G && G.tutorial && G.state!=='done'; }

function findForced(){ /* 找「真的可推理」的下一隻 */
  const N=G.N;
  const caught=[]; G.cells.forEach((c,i)=>{ if(c.revealed) caught.push(i); });
  const banned=new Set();
  caught.forEach(ci=>neighbors8(ci,N).forEach(nb=>banned.add(nb)));
  const isCand=i=>!G.cells[i].mark && !G.cells[i].revealed && !banned.has(i);
  const stars=[]; G.cells.forEach((c,i)=>{ if(c.cat && !c.revealed) stars.push(i); });
  for(const s of stars){
    const r=Math.floor(s/N), c=s%N, rg=G.cells[s].region;
    let rowC=0,colC=0,regC=0, rowOk=false,colOk=false,regOk=false;
    for(let i=r*N;i<r*N+N;i++) if(isCand(i)){ rowC++; if(i===s) rowOk=true; }
    for(let i=c;i<N*N;i+=N) if(isCand(i)){ colC++; if(i===s) colOk=true; }
    for(let i=0;i<N*N;i++) if(G.cells[i].region===rg && isCand(i)){ regC++; if(i===s) regOk=true; }
    if(rowC===1&&rowOk) return {cell:s, why:'第'+(r+1)+'列'};
    if(colC===1&&colOk) return {cell:s, why:'第'+(c+1)+'欄'};
    if(regC===1&&regOk) return {cell:s, why:'這個顏色區塊'};
  }
  return null;
}

async function demoEliminate(star, gap){
  const N=G.N, r=Math.floor(star/N), c=star%N;
  tutShow('接著推理：牠在第 <b>'+(r+1)+' 列</b> → 這列其他格不可能有 → ✕');
  for(let i=r*N;i<r*N+N;i++){ if(i!==star){ demoMark(i); await sleep(gap); } }
  if(!demoAlive()) return;
  tutShow('第 <b>'+(c+1)+' 欄</b>也一樣 ✕');
  for(let i=c;i<N*N;i+=N){ if(i!==star){ demoMark(i); await sleep(gap); } }
  if(!demoAlive()) return;
  const rg=G.cells[star].region;
  const regCells=[]; G.cells.forEach((cc,idx)=>{ if(cc.region===rg && idx!==star && cc.mark!=='x') regCells.push(idx); });
  if(regCells.length){
    tutShow('牠的<b>顏色區塊</b>裡也不會有第二隻 ✕');
    for(const i of regCells){ demoMark(i); await sleep(gap); }
  }
}

async function startDemo(){
  const tk=++demoToken;
  const ok=()=>tk===demoToken && G && G.tutorial==='demo' && G.state!=='done';
  G.state='demo';
  const N=G.N;
  const D=2000; /* 每個主步驟間隔 2 秒 */
  await sleep(600); if(!ok()) return;
  tutShow('歡迎來到尋龍高手 🎬 我先示範一局，你看著！');
  await sleep(D); if(!ok()) return;
  tutShow('盤面分成 <b>'+N+' 個顏色區塊</b>，每區剛好藏 <b>1 隻</b>恐龍');
  for(let rg=0; rg<N; rg++){
    tutClearRings();
    const cells=[]; G.cells.forEach((c,i)=>{ if(c.region===rg) cells.push(i); });
    tutRing(cells);
    await sleep(D); if(!ok()) return;
  }
  tutClearRings();
  tutShow('每條<b>橫列</b>也各剛好 1 隻');
  tutRing([...Array(N).keys()]);
  await sleep(D); if(!ok()) return;
  tutClearRings();
  tutShow('每條<b>直欄</b>也一樣');
  tutRing([...Array(N).keys()].map(r=>r*N));
  await sleep(D); if(!ok()) return;
  tutClearRings();
  tutShow('而且恐龍<b>絕不互相接觸</b>——連斜角都不行！');
  await sleep(D); if(!ok()) return;

  const stars=[...G.cats].sort((a,b)=>a-b);
  const s1=stars[0];
  tutShow('答案先偷偷告訴你：發光這格有一隻！<br>牠周圍 <b>8 格</b>（含斜角）都不可能有 → 全部打 ✕');
  tutRing(s1); tutFocus(true);
  await sleep(D); if(!ok()) return;
  for(const nb of neighbors8(s1,N).sort((a,b)=>a-b)){
    demoMark(nb); await sleep(500); if(!ok()) return;
  }
  await sleep(800); if(!ok()) return;
  tutShow('排除完成，鎖定目標——丟<b>捕捉器</b>！');
  setBallMode(true);
  SFX.ball();
  await sleep(D); if(!ok()) return;
  tutClearRings(); tutRing(s1);
  doBall(s1);
  await sleep(D); if(!ok()) return;
  tutShow('🐱 捕獲成功！還會登錄到圖鑑！');
  await sleep(D); if(!ok()) return;
  await demoEliminate(s1, 420); if(!ok()) return;
  await sleep(600); if(!ok()) return;

  const f2=findForced();
  tutShow(f2 ? '看！<b>'+f2.why+'</b>只剩這格沒被 ✕ → 牠<b>鐵定在這</b>！丟球！'
             : '候選格變少了！教學直接告訴你：這格有一隻，丟球！');
  if(!G.ballMode) setBallMode(true);
  const s2=stars[1];
  tutClearRings(); tutRing(s2);
  await sleep(D); if(!ok()) return;
  doBall(s2);
  await sleep(D); if(!ok()) return;
  await demoEliminate(s2, 300); if(!ok()) return;
  await sleep(600); if(!ok()) return;

  for(let k=2;k<stars.length;k++){
    const f=findForced();
    tutShow(f ? '<b>'+f.why+'</b>只剩一個候選格 → 丟球！' : '如法炮製——丟球！');
    if(!G.ballMode) setBallMode(true);
    tutClearRings(); tutRing(stars[k]);
    await sleep(D); if(!ok()) return;
    doBall(stars[k]);
    await sleep(D); if(!ok()) return;
    if(k<stars.length-1){ await demoEliminate(stars[k], 240); if(!ok()) return; }
  }
  tutHide();
}

async function startGuided(){
  const tk=++demoToken;
  const ok=()=>tk===demoToken && G && G.tutorial==='guided';
  const N=G.N;
  await sleep(400); if(!ok()) return;
  tutShow('換你上場！這局有 <b>'+N+' 隻</b>恐龍，跟著金色發光提示走 🙌', '開始！');
  await waitBtn(); if(!ok()) return;

  const stars=[...G.cats].sort((a,b)=>a-b);
  const s1=stars[0];

  const safe=neighbors8(s1,N)[0];
  tutShow('先熟悉操作：點發光那格<b>打 ✕</b><br>（它緊貼等下的獵物，確定沒有恐龍）');
  await waitCellClick([safe]); if(!ok()) return;
  await sleep(350); if(!ok()) return;
  tutShow('再點一次可以<b>取消 ✕</b>，試試看！');
  await waitCellClick([safe]); if(!ok()) return;
  await sleep(350); if(!ok()) return;
  tutShow('很好！再<b>打回 ✕</b>（確定沒有，就標起來）');
  await waitCellClick([safe]); if(!ok()) return;
  await sleep(400); if(!ok()) return;

  tutShow('該你了：點下面的 <b>捕捉器</b> 按鈕切換模式');
  await waitBall(true); if(!ok()) return;
  SFX.ball();
  tutShow('游標變捕捉器了！教學偷偷報料——發光那格有一隻，<b>點牠丟球</b>！');
  await waitCellClick([s1]); if(!ok()) return;
  doBall(s1);
  await sleep(1900); if(!ok()) return;

  const r1=Math.floor(s1/N), c1=s1%N;
  tutShow('🎉 第一次捕獲！接著推理：牠在第 <b>'+(r1+1)+' 列</b> → 這列其他格都沒有。<br>先切回一般模式：再點一下<b>捕捉器</b>按鈕');
  await waitBall(false); if(!ok()) return;
  SFX.ball();
  const rowCells=[]; for(let i=r1*N;i<r1*N+N;i++) if(i!==s1 && G.cells[i].mark!=='x') rowCells.push(i);
  tutShow('把<b>第 '+(r1+1)+' 列</b>剩下的格子全部 ✕（任一順序）');
  await waitCells(rowCells); if(!ok()) return;
  await sleep(350); if(!ok()) return;
  const colCells=[]; for(let i=c1;i<N*N;i+=N) if(i!==s1 && G.cells[i].mark!=='x') colCells.push(i);
  tutShow('<b>第 '+(c1+1)+' 欄</b>也一樣 ✕');
  await waitCells(colCells); if(!ok()) return;
  await sleep(350); if(!ok()) return;
  const diagCells=neighbors8(s1,N).filter(i=>Math.floor(i/N)!==r1 && i%N!==c1 && G.cells[i].mark!=='x');
  if(diagCells.length){
    tutShow('別忘<b>斜角</b>！這 '+diagCells.length+' 格也不可能有人 ✕');
    await waitCells(diagCells); if(!ok()) return;
    await sleep(300); if(!ok()) return;
  }
  const rg1=G.cells[s1].region;
  const regRest=[]; G.cells.forEach((c,i)=>{ if(c.region===rg1 && i!==s1 && c.mark!=='x') regRest.push(i); });
  if(regRest.length){
    tutShow('牠的<b>顏色區塊</b>不會有第二隻——這幾格我幫你標 ✕');
    for(const i of regRest){ demoMark(i); await sleep(130); if(!ok()) return; }
    await sleep(500); if(!ok()) return;
  }

  for(let k=1;k<stars.length;k++){
    const f=findForced();
    if(!G.ballMode){
      tutShow(f ? '看！<b>'+f.why+'</b>只剩一個候選格！先切到<b>捕捉器</b>' : '下一隻在發光那格！先切到<b>捕捉器</b>');
      await waitBall(true); if(!ok()) return;
      SFX.ball();
    }
    tutShow(f ? '<b>'+f.why+'</b>只剩這格沒被 ✕ → 牠鐵定在這，<b>丟球！</b>'
               : '教學提示：發光那格有一隻，<b>丟球！</b>');
    await waitCellClick([stars[k]]); if(!ok()) return;
    doBall(stars[k]);
    await sleep(1900); if(!ok()) return;
    if(k<stars.length-1){
      tutShow('我幫你把相關格子 ✕ 起來…');
      const rg=G.cells[stars[k]].region;
      const rk=Math.floor(stars[k]/N), ck=stars[k]%N;
      const todo=[]; G.cells.forEach((c,i)=>{
        if(c.mark==='x'||c.revealed) return;
        if(Math.floor(i/N)===rk||i%N===ck||c.region===rg||neighbors8(stars[k],N).includes(i)) todo.push(i);
      });
      for(const i of todo){ demoMark(i); await sleep(70); if(!ok()) return; }
      await sleep(400); if(!ok()) return;
    }
  }
  tutHide();
}

$('tut-skip').onclick = ()=>{
  demoToken++;
  clearExpect();
  tutHide();
  if(G){ G.state='done'; timerStop(); }
  openMenu();
};

/* ---------- 其他 UI ---------- */
function show(id){ $(id).classList.add('show'); syncDlg(); }
function hide(id){ $(id).classList.remove('show'); syncDlg(); }
function syncDlg(){ const d=$('dlg'); if(!d) return; d.style.visibility = document.querySelector('.overlay.show:not(#ov-menu)') ? 'hidden' : 'visible'; }
function floatText(el, text, color){
  const s=document.createElement('span');
  s.className='float'; s.textContent=text; s.style.color=color;
  el.appendChild(s);
  setTimeout(()=>s.remove(),1150);
}
function confetti(){
  const colors=['#ff9d5c','#ffd166','#06d6a0','#118ab2','#ef476f','#c77dff'];
  for(let k=0;k<40;k++){
    const d=document.createElement('i');
    d.className='cf';
    d.style.left = Math.random()*100+'vw';
    d.style.background = colors[k%colors.length];
    d.style.width = d.style.height = (6+Math.random()*8)+'px';
    d.style.animationDuration = (1.6+Math.random()*1.4)+'s';
    d.style.animationDelay = (Math.random()*0.5)+'s';
    document.body.appendChild(d);
    setTimeout(()=>d.remove(),3600);
  }
}
function renderLiveDex(){

  let card =
    document.getElementById(
      "livedex-panel"
    );

  if(!card){

    const best =
      document.getElementById(
        "best-line"
      );

    if(!best) return;

    card=document.createElement("div");

    card.id="livedex-panel";

    card.innerHTML=
      '<div class="ld-title">📖 LiveDex</div>'+
      '<div id="ld-count" class="ld-count"></div>'+
      '<div class="ld-bar">'+
      '<div id="ld-fill"></div>'+
      '</div>'+
      '<div id="ld-pct" class="ld-pct"></div>'+'<div class="ld-recent" id="ld-recent"></div>';

    best.insertAdjacentElement(
      "afterend",
      card
    );
  }

  const total = allMons().length;
  const got   = dexGot.size;

  const pct =
    total
      ? Math.floor(got * 100 / total)
      : 0;

  document.getElementById(
    "ld-count"
  ).textContent =
    got + " / " + total;

  document.getElementById(
    "ld-pct"
  ).textContent =
    pct + "%";

 document.getElementById(
  "ld-fill"
).style.width =
  pct + "%";

const r =
  document.getElementById(
    "ld-recent"
  );

if(r){

  if(!RECENT_DEX.length){

    r.innerHTML =
      '<div class="ld-rtitle">最近發現</div>'+
      '<div class="ld-empty">尚無資料</div>';

  }else{

    r.innerHTML =
      '<div class="ld-rtitle">最近發現</div>'+

      RECENT_DEX.map(id=>{

        const m =
          MON_BY_ID[id];

        return m
          ? '<div class="ld-item">🦖 '+m.name+'</div>'
          : '';

      }).join('');
  }
}

}

function refreshBest(){

  const t=lvTotal();

  $('best-line').textContent =
    t>0
      ? ('⏱ 個人總分：'+t+
         ' · 🌌 種子 '+(ECON.seeds||0)+
         ' · 🎟 券 '+(ECON.tickets||0))
      : ('🌌 種子 '+(ECON.seeds||0)+
         ' · 🎟 券 '+(ECON.tickets||0));
}

/* ---------- 尋龍地圖引擎 ---------- */
const MAP_DECOR=[['🌲',6,28],['🌲',12,42],['🏔',70,6],['🗻',88,34],['🌋',86,60],['🏜',4,68],['🌵',24,88],['🏰',18,20],['⛩️',86,14],['🌊',48,56],['🦴',44,30],['🌺',8,10]];
function renderMap(){
  const box=$('map-nodes'); if(!box) return;
  box.innerHTML='';
  const svg=$('map-svg');
  if(svg){
    const pts=[];
    for(let n=4;n<=14;n++){ const p=MAP_POS[n]; pts.push(p[0]+','+(p[1]*1.15).toFixed(1)); }
    svg.innerHTML='<polyline points="'+pts.join(' ')+'"/>'+pts.map(p=>{ const c=p.split(','); return '<circle cx="'+c[0]+'" cy="'+c[1]+'" r="1.1"/>'; }).join('');
  }
  const dc=$('map-decor');
  if(dc && !dc.children.length) MAP_DECOR.forEach(d=>{ const s=document.createElement('span'); s.textContent=d[0]; s.style.left=d[1]+'%'; s.style.top=d[2]+'%'; dc.appendChild(s); });
  for(let n=4;n<=14;n++){
    const meta=REGION_META[n];
    const rec=lvRec(n);
    const cleared=rec.total>0;
    const unlocked=isUnlocked(n);
    const b=document.createElement('button');
    b.className='mnode'+(cleared?' clear':(unlocked?' new':' lock'));
    b.style.left=MAP_POS[n][0]+'%';
    b.style.top=MAP_POS[n][1]+'%';
    const sub = !unlocked ? '🔒 未探索'
      : cleared ? ('✅ '+(rec.best?fmtSec(rec.best):'已通關'))
      : (n<=5 ? '🎓 教學' : '⏱ '+n+':00');
    b.innerHTML='<span class="me">'+meta.e+'</span><span class="mn">'+n+'×'+n+'</span><span class="ms">'+meta.name+' · '+sub+'</span>';
    b.onclick=()=>{
      if(!isUnlocked(n)){ SFX.wrong(); b.style.animation='shake .3s'; setTimeout(()=>b.style.animation='',320); if(typeof doBuddyChat==='function' && BUDDY.id) doBuddyChat('那個區域還不能去～先通過前面的區域吧！'); return; }
      openLevel(n);
    };
    box.appendChild(b);
  }
}
function openLevel(n){ hide('ov-menu'); newRun(n); }
function openMenu(){

  renderMap();

  refreshBest();

  renderLiveDex();

  show('ov-menu');
}
$('btn-help').onclick = ()=>show('ov-help');
$('menu-help').onclick = ()=>show('ov-help');
$('help-ok').onclick = ()=>hide('ov-help');
$('btn-sound').onclick = ()=>{
  soundOn = !soundOn;
  LS.set('dinodoku-sound', soundOn?'1':'0');
  $('btn-sound').textContent = soundOn?'🔊':'🔇';
};
