const POOL_SIZES = [10,11,12,13,14];
const livePool = {};
function poolInit(){
  POOL_SIZES.forEach(n=>{
    const arr = POOL_DATA[String(n)]||[];
    livePool[n] = arr.map(s=>s.split(',').map(Number));
  });
}
function transformBoard(N, regionOf){ /* 隨機旋轉/鏡像 ×8 */
  const T=Math.floor(Math.random()*8), ro=new Array(N*N);
  for(let r=0;r<N;r++)for(let c=0;c<N;c++){
    let r2=r,c2=c;
    if(T&1){ const t=r2; r2=c2; c2=t; }
    if(T&2){ r2=N-1-r2; }
    if(T&4){ c2=N-1-c2; }
    ro[r2*N+c2]=regionOf[r*N+c];
  }
  return ro;
}
function poolTake(n){
  if(!livePool[n] || !livePool[n].length) return null;
  const idx=Math.floor(Math.random()*livePool[n].length);
  const ro=livePool[n].splice(idx,1)[0];
  return transformBoard(n, ro);
}
let poolBusy=false;
function poolRefill(){ /* 只在閒置時補貨，不搶遊戲時間 */
  if(poolBusy) return;
  if(G && !G.tutorial && G.state==='marking' && !document.querySelector('.overlay.show')) return;
  const need=POOL_SIZES.filter(n=>(livePool[n]||[]).length<6);
  if(!need.length) return;
  poolBusy=true;
  setTimeout(()=>{
    const n=need[Math.floor(Math.random()*need.length)];
    const pz=generatePuzzle(n, n>=13?3000:1400);
    if(pz) livePool[n].push(Array.from(pz.regionOf));
    poolBusy=false;
  }, 30);
}

/* ---------- LV 戰績（個人分數） ---------- */
let LV = {};
try{ LV = JSON.parse(LS.get('dinodoku-lv')||'{}')||{}; }catch(e){ LV={}; }
function lvRec(n){ return LV[String(n)]||{best:0,total:0}; }
function lvTotal(){ let t=0; Object.keys(LV).forEach(k=>{ t+=LV[k].total||0; }); return t; }
function lvSave(){ LS.set('dinodoku-lv', JSON.stringify(LV)); }
function fmtSec(s){
  s=Math.max(0, Math.floor(s));
  if(s>=3600){ const h=Math.floor(s/3600), m=Math.floor(s%3600/60), ss=s%60; return h+':'+String(m).padStart(2,'0')+':'+String(ss).padStart(2,'0'); }
  return Math.floor(s/60)+':'+String(s%60).padStart(2,'0');
}
function renderLV(){
  const el=$('lv-rows2')||$('lv-rows'); if(!el) return;
  el.innerHTML='';
  for(let n=6;n<=14;n++){
    const r=lvRec(n);
    const d=document.createElement('div');
    d.className='lvrow'+((G&&G.N===n&&!G.tutorial)?' cur':'');
    d.innerHTML='<b>LV'+n+'</b><span><span class="lvv">'+(r.best?r.best:'—')+'</span><span class="lvt">'+(r.total?'Σ'+r.total:'')+'</span></span>';
    el.appendChild(d);
  }
}

/* ---------- 經濟系統：星願種子／獎勵券 ---------- */
let ECON = { seeds:0, tickets:0, luck:0 };
try{ ECON = Object.assign(ECON, JSON.parse(LS.get('dinodoku-econ')||'{}')||{}); }catch(e){}
function econSave(){ LS.set('dinodoku-econ', JSON.stringify(ECON)); }
function econRender(){
  const free=!!ECON.devFree;
  $('tickets').textContent = free?'∞':(ECON.tickets||0);
  $('seeds').textContent = free?'∞':(ECON.seeds||0);
  const rw=$('rw-tickets'); if(rw) rw.textContent = free?'∞':(ECON.tickets||0);
  document.querySelectorAll('#reward-games .rg-btn').forEach(b=>{ b.disabled=!(free||ECON.tickets>0); });
  updateHintBtn();
}

/* ---------- 稀有度／遠古資料 ---------- */
const RARITY_NAMES = ['⭐','⭐⭐','⭐⭐⭐','⭐⭐⭐⭐','⭐⭐⭐⭐⭐'];
const RARITY_BADGE = ['🟢','🔵','🟣','🟠','💠'];
function rarityOf(id){
  const m = MON_BY_ID[id];
  return m ? (m.stars||1)-1 : 0;
}
let MON_BY_ID = {};
POKEMON.forEach(p=>{ MON_BY_ID[p.id]=p; });
if(typeof LEGENDS!=='undefined') LEGENDS.forEach(p=>{ MON_BY_ID[p.id]=p; });
function allMons(){ return (typeof LEGENDS!=='undefined') ? POKEMON.concat(LEGENDS) : POKEMON; }

/* ---------- 尋龍地圖：區域／出沒地／解鎖 ---------- */
const REGION_META = {
  4:{name:'起源地',e:'🌱'}, 5:{name:'幼龍平原',e:'🌿'}, 6:{name:'翠風草原',e:'🍃'},
  7:{name:'碎岩丘陵',e:'⛰️'}, 8:{name:'迷霧森林',e:'🌲'}, 9:{name:'月光沼澤',e:'🌙'},
  10:{name:'烈陽峽谷',e:'🌵'}, 11:{name:'霜牙雪嶺',e:'❄️'}, 12:{name:'古城遺跡',e:'🏛️'},
  13:{name:'雲海神殿',e:'⛩️'}, 14:{name:'龍之巔峰',e:'🐉'}
};
/* 地圖節點位置（x%, y%），路線由 4×4 起源地蜿蜒至 14×14 龍之巔峰 */
const MAP_POS = {4:[13,88],5:[36,80],6:[61,88],7:[83,75],8:[64,61],9:[39,65],10:[15,53],11:[29,39],12:[55,41],13:[79,27],14:[54,11]};
function regionLabel(n){ const m=REGION_META[n]; return m.e+m.name+'（'+n+'×'+n+'）'; }
/* 3★以上恐龍的出沒區域：以 id 雜湊穩定決定（3★→3 個、4★→2 個、5★→1 個，皆位於 6×6~14×14） */
function habitatsOf(id){
  const m=MON_BY_ID[id];
  if(!m || (m.stars||1)<3) return [];
  const k=(m.stars===3)?3:(m.stars===4)?2:1;
  const avail=[6,7,8,9,10,11,12,13,14];
  let h=(id*2654435761)>>>0;
  const res=[];
  for(let i=0;i<k;i++){ h=(h*1103515245+12345)>>>0; res.push(avail.splice(h%avail.length,1)[0]); }
  return res.sort((a,b)=>a-b);
}
/* 出現權重：基礎 1★>2★>3★>4★>5★；出沒區域內 ×4（整體機率仍維持星級遞減） */
const SPAWN_W=[24,16,6,4,3];
function spawnWeight(p,N){
  let w=SPAWN_W[(p.stars||1)-1]||1;
  if(N>=6 && habitatsOf(p.id).includes(N)) w*=4;
  return w;
}
/* 區域解鎖進度：從 4×4 起源地開始，過關解鎖下一區 */
let PROG = { max:4 };
try{ PROG = Object.assign({max:4}, JSON.parse(LS.get('dinodoku-prog')||'{}')||{}); }catch(e){}
(function(){ /* 舊版玩家遷移：依 LV 戰績推算已解鎖區域 */
  let m=4;
  for(let n=6;n<=14;n++){ if(lvRec(n).total>0) m=Math.max(m,n+1); }
  PROG.max=Math.max(PROG.max||4, Math.min(14,m));
})();
function progSave(){ LS.set('dinodoku-prog', JSON.stringify(PROG)); }
function isUnlocked(n){ return n<=(PROG.max||4); }
function progUnlock(n){ if(n>(PROG.max||4) && n<=14){ PROG.max=n; progSave(); return true; } return false; }
/* 出沒區域透露狀態（隨行閒聊可解鎖未收服恐龍的出沒情報） */
let HAB_REVEALED=new Set();
try{ HAB_REVEALED=new Set(JSON.parse(LS.get('dinodoku-hab')||'[]')||[]); }catch(e){}
HAB_REVEALED=new Set([...HAB_REVEALED].filter(id=>MON_BY_ID[id]));
function habSave(){ LS.set('dinodoku-hab', JSON.stringify([...HAB_REVEALED])); }

/* 顏色屬性：越稀有越多色（1~4），以 id 雜湊決定 */
function colorAttrs(id, N){
  const rk=rarityOf(id);
  const n=rk+1;
  const cols=[]; let h=id*2654435761 % 4294967296;
  for(let k=0;k<n;k++){ h=(h*1103515245+12345)>>>0; cols.push(h%12); }
  return [...new Set(cols)].slice(0,Math.max(1,n));
}

/* ---------- 技能庫／潛能激發 ---------- */
const SKILLS = [
  {id:'lucky1', n:'幸運星塵', t:0, d:'下次獎勵小遊戲多 1 顆種子'},
  {id:'sweep1', n:'微風掃除', t:0, d:'自動標記 1 格沒有恐龍 ✕'},
  {id:'sweep2', n:'色系淨化', t:1, d:'自動標記 2 格沒有恐龍 ✕'},
  {id:'hint1',  n:'心靈感應', t:1, d:'免費提示一隻恐龍'},
  {id:'time15', n:'時間沙·小', t:1, d:'沙漏 +15 秒'},
  {id:'sweep3', n:'色系暴風', t:2, d:'自動標記 4 格沒有恐龍 ✕'},
  {id:'intel',  n:'情報耳語', t:2, d:'透露可能的藏匿座標'},
  {id:'time30', n:'時間沙·大', t:2, d:'沙漏 +30 秒'},
  {id:'reveal', n:'星願爆發', t:3, d:'直接召喚一隻恐龍'},
  {id:'luck2',  n:'幸運共鳴', t:3, d:'下次獎勵必出稀有以上'},
];
const AWAKEN_COST = [5,25,125,500];
const SKILL_TIER_NAME = ['一星','二星','三星','四星'];
const INNATE_BY_STAR = {3:'hint1',4:'intel',5:'reveal'};
const POTENTIAL_PER_WIN = 10;
function starsOf(id){ const m=MON_BY_ID[id]; return m?(m.stars||1):1; }
function slotsOf(id){ return [0,0,1,1,2,3][starsOf(id)]||0; }
function maxSkillTierOf(id){ return starsOf(id)-2; }
function innateSkillOf(id){ return INNATE_BY_STAR[starsOf(id)]||null; }
function awakenCostOf(id){ return AWAKEN_COST[maxSkillTierOf(id)]||0; }
function skillRangeLabel(id){ return maxSkillTierOf(id)<=0?'一星技能':'一～'+SKILL_TIER_NAME[maxSkillTierOf(id)]+'技能'; }
let SK = {};
try{ SK = JSON.parse(LS.get('dinodoku-skills')||'{}')||{}; }catch(e){ SK={}; }
SK=Object.fromEntries(Object.entries(SK).flatMap(([id,list])=>{
  if(!MON_BY_ID[id] || !Array.isArray(list)) return [];
  const innate=innateSkillOf(id), maxTier=maxSkillTierOf(id), slots=slotsOf(id), clean=[];
  list.forEach(skillId=>{
    const skill=SKILLS.find(s=>s.id===skillId);
    if(skill && skill.t<=maxTier && skillId!==innate && !clean.includes(skillId) && clean.length<slots) clean.push(skillId);
  });
  return clean.length?[[id,clean]]:[];
}));
function skSave(){ LS.set('dinodoku-skills', JSON.stringify(SK)); }
skSave();
let POT = {};
try{ POT = JSON.parse(LS.get('dinodoku-potential')||'{}')||{}; }catch(e){ POT={}; }
POT=Object.fromEntries(Object.entries(POT).flatMap(([id,value])=>{
  if(!MON_BY_ID[id] || starsOf(id)<2) return [];
  return [[id,Math.max(0,Math.min(100,Math.floor(+value||0)))]];
}));
function potentialSave(){ LS.set('dinodoku-potential', JSON.stringify(POT)); }
function potentialOf(id){ return starsOf(id)>=2?(POT[id]||0):0; }
function potentialGain(id, amount){
  if(!id || starsOf(id)<2) return 0;
  const before=potentialOf(id);
  POT[id]=Math.min(100,before+amount);
  potentialSave();
  if(id===BUDDY.id) frRender();
  return POT[id]-before;
}
potentialSave();

/* 技能冷卻（秒）：隨行發動與說明表共用 */
const SKILL_CD = [15,25,40,60];
function renderHelpSkills(){
  const box=$('help-skills'); if(!box) return;
  let h='<table class="skill-table"><tr><th>星級</th><th>技能</th><th>效果</th><th>冷卻</th></tr>';
  SKILLS.forEach(S=>{
    h+='<tr><td><span class="tier t'+S.t+'">'+SKILL_TIER_NAME[S.t]+'</span></td>'
      +'<td class="sk-nm">'+S.n+'</td>'
      +'<td>'+S.d+'</td>'
      +'<td class="sk-cd">'+SKILL_CD[S.t]+' 秒</td></tr>';
  });
  box.innerHTML=h+'</table>';
}
renderHelpSkills();

/* ---------- 隨行／友好度 ---------- */
let BUDDY = { id:0 };
try{ BUDDY = Object.assign({id:0}, JSON.parse(LS.get('dinodoku-buddy')||'{}')||{}); }catch(e){}
if(BUDDY.id && !MON_BY_ID[BUDDY.id]){ BUDDY.id=0; LS.set('dinodoku-buddy', JSON.stringify(BUDDY)); }
let FR = {};  /* monId -> 友好度%（跟著恐龍） */
try{ FR = JSON.parse(LS.get('dinodoku-friend')||'{}')||{}; }catch(e){ FR={}; }
FR=Object.fromEntries(Object.entries(FR).filter(([id])=>MON_BY_ID[id]));
try{ /* friend2 過渡期資料：併入當前隨行，避免丟失 */
  const f2 = +LS.get('dinodoku-friend2')||0;
  const bid = (JSON.parse(LS.get('dinodoku-buddy')||'{"id":0}')||{}).id;
  if(f2>0 && bid && !(FR[bid]>0)){ FR[bid]=f2; frSave(); }
}catch(e){}
function frSave(){ LS.set('dinodoku-friend', JSON.stringify(FR)); }
function frOf(id){ return FR[id]||0; }

/* ---------- 隨行引擎：renderBuddy / 閒聊 / 技能發動（v2.0 patch3） ---------- */
