  '那個角落…有戲！','我看到希望了！','坚持就是勝利！','我們配合得真好！','你是最棒的訓練師！','這局肯定沒問題！','相信我！','跟著我說：我能行！','一步一步來～','慢慢來比較快！','不要急於一時～','時候到了就會過！','順其自然吧！','享受當下！','今天会是美好的一天！',
'💡 每個顏色區塊、每行每列都只有 1 隻，而且不能互相碰到喔！','💡 先從最大的區塊開始找，選擇最少的地方下手！','💡 不確定的格子先打 ✕ 排除，盤面會越來越清楚！','💡 捕捉器比恐龍數量多 3 個，大膽一點沒關係！','💡 卡住的話，用 🌿 提示找一隻還沒抓到的吧！','💡 每行只能有一隻——抓到一隻，那行其他格都能 ✕ 掉！','💡 相鄰的格子（連斜角）都不會有恐龍，圍繞著排除！'
];
const BUDDY_SKILL_TALK = {
  sweep1:'嘿！讓我幫你清除一個障礙！',
  sweep2:'看我的！顏色淨化啟動！',
  hint1:'我感應到了！這裡有一隻！',
  time15:'時間…增加了！',
  time30:'時間…大幅增加！',
  intel:'噓…我告訴你一個秘密…',
  reveal:'出來吧！我的力量！',
  luck1:'幸運星塵，啟動！',
  luck2:'幸運共鳴，爆發！'
};
function renderBuddy(){
  const dlg=$('dlg');
  if(!dlg) return;
  const m=BUDDY.id ? MON_BY_ID[BUDDY.id] : null;
  dlg.classList.remove('st1','st2','st3','st4','st5','none');
  if(!m){
    dlg.classList.add('none');
    $('dlg-img').removeAttribute('src');
    $('dlg-name').textContent='？？？';
    if(!$('dlg-text').dataset.lock) $('dlg-text').innerHTML='還沒有隨行夥伴～到 <b>📖 圖鑑</b> 點一隻已捕獲的恐龍，設為隨行吧！';
    $('dlg-frp').textContent='';
    $('dlg-skills').innerHTML='';
    $('dlg-feed').style.display='none';
    return;
  }
  const starClass='st'+(m.stars||1);
  dlg.classList.add(starClass);
  $('dlg-img').src=m.img;
  $('dlg-name').innerHTML=m.name+' <small>'+RARITY_NAMES[(m.stars||1)-1]+'</small>';
  if(!$('dlg-text').textContent || $('dlg-text').textContent==='…') $('dlg-text').textContent='準備好了！我們一起出發吧！';
  $('dlg-feed').style.display='';
  frRender();
  renderBuddySkills();
if(typeof renderLiveDex==="function"){
  renderLiveDex();
}
}
$('dlg-ava').onclick=()=>{ if(BUDDY.id && MON_BY_ID[BUDDY.id]) showDexDetail(MON_BY_ID[BUDDY.id]); };
function buddySkillList(){
  if(!BUDDY.id) return [];
  const innate=innateSkillOf(BUDDY.id);
  const ids=[innate,...(SK[BUDDY.id]||[])].filter(Boolean);
  return ids.map(id=>SKILLS.find(s=>s.id===id)).filter(Boolean);
}
function renderBuddySkills(){
  const box=$('dlg-skills');
  if(!box) return;
  box.innerHTML='';
  const skills=buddySkillList();
  if(!skills.length){ box.innerHTML='<span style="font-size:11px;color:#a39483">無技能</span>'; return; }
  const innate=innateSkillOf(BUDDY.id);
  skills.forEach(S=>{
    const b=document.createElement('button');
    b.className='bskill';
    b.title=(S.id===innate?'天生技能 · ':'')+S.d;
    b.textContent=(S.id===innate?'✦ ':'')+S.n;
    const cdMs=(SKILL_CD[S.t]||20)*1000;
    b.onclick=(e)=>{
      e.stopPropagation();
      if(!G || G.state!=='marking' || G.tutorial){ doBuddyChat('現在不是戰鬥時間～休息一下！'); return; }
      if(Date.now()<buddySkillCd){ doBuddyChat('技能冷卻中…再等一下！'); return; }
      buddySkillCd=Date.now()+cdMs;
      triggerBuddySkill(S.id);
    };
    box.appendChild(b);
  });
}
const BUDDY_GOSSIP=[
  '聽說{name}每天晚上都要數星星才睡得著～','{name}其實很喜歡唱歌，只是有五音不全的小毛病！','別看{name}長那樣，牠可是跑步高手呢！',
  '{name}最怕的事情居然是…剪指甲！','聽說{name}的夢想是有一天能飛上天空！','{name}最喜歡的食物是香噴噴的蕨類大餐！',
  '{name}其實是深藏不露的舞蹈高手喔！','聽說{name}看到閃電會躲進被窩裡，哈！','{name}最近學會了新把戲：裝死！騙到不少人呢～',
  '聽說{name}每天都會做早操保持健康！','{name}對自己的尾巴最得意了，每天都要梳理！','聽說{name}一直想學游泳…但牠有點怕水！'
];
const BUDDY_MENU_TALK=[
  '今天想去哪個區域探險呢？','地圖上灰色的區域還不能去，要先通過前面的地方！','越上面的區域，藏著的恐龍越稀有喔！',
  '帶我去出沒區域走走嘛，說不定會遇到傳說中的恐龍！','抓到的恐龍可以到圖鑑裡設為隨行喔！','記得餵我吃 🌌 種子，我會更有精神！',
  '聽說把友好度練滿，我會變得更厲害！','獎勵小遊戲有機會直接抽到稀有恐龍呢！'
];
function inGame(){ return !!(G && G.state==='marking' && !G.tutorial); }
function menuTalk(){
  const uncaught=allMons().filter(p=>(p.stars||1)>=3 && !dexGot.has(p.id));
  if(uncaught.length && Math.random()<0.45){
    const m=uncaught[Math.floor(Math.random()*uncaught.length)];
    const habs=habitatsOf(m.id).map(regionLabel).join('、');
    HAB_REVEALED.add(m.id); habSave();
    return '🤫 偷偷告訴你…聽說<b>「'+m.name+'」</b>出沒在 '+habs+'！去那些區域找牠，出現率會大增喔！';
  }
  if(Math.random()<0.55){
    const all=allMons();
    const m=all[Math.floor(Math.random()*all.length)];
    return '💬 '+BUDDY_GOSSIP[Math.floor(Math.random()*BUDDY_GOSSIP.length)].replace('{name}','【'+m.name+'】');
  }
  return BUDDY_MENU_TALK[Math.floor(Math.random()*BUDDY_MENU_TALK.length)];
}
function pickTalk(){
  if(inGame()) return BUDDY_TALK[Math.floor(Math.random()*BUDDY_TALK.length)];
  return BUDDY.id ? menuTalk() : '';
}
let buddyChatTimer=null;
function doBuddyChat(msg){
  const t=$('dlg-text');
  if(!t) return;
  const txt=msg || pickTalk();
  if(!txt) return;
  t.dataset.lock='1';
  t.innerHTML=txt;
  t.classList.remove('new'); void t.offsetWidth; t.classList.add('new');
}
function scheduleBuddyChat(){
  clearTimeout(buddyChatTimer);
  const delay=inGame() ? 30000+Math.random()*60000 : 18000+Math.random()*22000;
  buddyChatTimer=setTimeout(()=>{ doBuddyChat(); scheduleBuddyChat(); }, delay);
}
function startBuddyTimers(){
  clearTimeout(buddyChatTimer);
  if(BUDDY.id) doBuddyChat('準備好了！我們一起找恐龍吧！');
  scheduleBuddyChat();
}
function stopBuddyTimers(){ clearTimeout(buddyChatTimer); buddyChatTimer=null; }
function frGain(id, pct){
  if(!id) return;
  let f=frOf(id);
  f=Math.min(100, f+pct);
  FR[id]=f; frSave();
  frRender();
  if(id===BUDDY.id && f>=10 && f%10===0 && f<100){ showHeart(); }
  if(id===BUDDY.id && f>=25 && f%25===0 && f<100){ doBuddyChat('我們的羈絆更深了！<b>♥ '+(f)+'%</b>'); }
}
function frRender(){
  const el=$('dlg-frp');
  if(!el || !BUDDY.id) return;
  const potential=starsOf(BUDDY.id)>=2?' · ⚡ '+potentialOf(BUDDY.id)+'/100':'';
  el.textContent='♥ '+frOf(BUDDY.id)+'%'+potential;
}
function feedBuddy(){
  if(!BUDDY.id) return;
  const b=$('dlg-feed');
  if(b && b.disabled) return;
  if(!ECON.devFree && (ECON.seeds||0)<1){ doBuddyChat('還想再吃…可是沒有 🌌 種子了！'); SFX.wrong(); return; }
  if(!ECON.devFree){ ECON.seeds--; }
  econSave(); econRender();
  frGain(BUDDY.id, 5);
  doBuddyChat('好吃！😋 <b>♥+'+5+'%</b> 謝謝你～');
  SFX.catchp();
  if(b){ b.disabled=true; setTimeout(()=>{ b.disabled=false; },1500); }
}
function showHeart(){ if(!$('dlg')) return; const h=document.createElement('span'); h.className='bheart'; h.textContent='♥'; h.style.left='34px'; h.style.bottom='64px'; $('dlg').appendChild(h); setTimeout(()=>h.remove(),1100); }
let buddySkillCd=0;
function triggerBuddySkill(forceSk){
  if(!BUDDY.id) return;
  const skills=buddySkillList();
  const selected=forceSk?skills.find(S=>S.id===forceSk):skills[Math.floor(Math.random()*skills.length)];
  if(!selected){ doBuddyChat('我還沒有技能，先去圖鑑激發潛能吧！'); return; }
  const sk=selected.id;
  const S=selected;
  let done=false;
  const doMsg=()=>doBuddyChat(BUDDY_SKILL_TALK[sk]||'我用技能了！');
  if(sk==='sweep1'){ const c=findRandomSafe(); if(c!==-1){ G.cells[c].mark='x'; cellEls[c].classList.add('x'); updateStatus(); SFX.tap(); done=true; } }
  else if(sk==='sweep2'||sk==='sweep3'){ const n=sk==='sweep3'?4:2; const w=[]; for(let i=0;i<n;i++){ const c=findRandomSafe(); if(c!==-1)w.push(c); } w.forEach(c=>{ G.cells[c].mark='x'; cellEls[c].classList.add('x'); }); updateStatus(); if(w.length)SFX.tap(); done=!!w.length; }
  else if(sk==='hint1'){ if(typeof freeHint==='function' && typeof showHintAt==='function'){ const i=freeHint(); if(i!==null){ showHintAt(i); done=true; } } }
  else if(sk==='time15'){ timerAdd(15); done=true; }
  else if(sk==='time30'){ timerAdd(30); done=true; }
  else if(sk==='intel'){ const cand=[...G.cats].filter(i=>!G.cells[i].revealed); if(cand.length){ const fr=frOf(BUDDY.id); const sure=cand.filter(()=>Math.random()<fr/100); if(sure.length){ const i=sure[0]; const rc=Math.floor(i/G.N)%G.N+1, cc=i%G.N+1; doBuddyChat('我覺得…<b>第'+rc+'行第'+cc+'列</b>可能有恐龍！'); done=true; } else { doBuddyChat('嗯…我也不是很確定呢…'); done=true; } } }
  else if(sk==='reveal'){ const cand=[...G.cats].filter(i=>!G.cells[i].revealed); if(cand.length){ const i=cand[Math.floor(Math.random()*cand.length)]; G.cells[i].revealed=true; cellEls[i].classList.add('alive'); G.found++; updateStatus(); updateHUD(); SFX.catchp(); checkBallEnd(); done=true; } }
  else if(sk==='luck1'||sk==='luck2'){ ECON.luck=(ECON.luck||0)|(sk==='luck1'?1:2); econSave(); econRender(); done=true; }
  if(done){ SFX.catchp(); doMsg(); }
  else if(forceSk){ doBuddyChat('嗯…現在用不上這個技能呢～'); }
}
function findRandomSafe(){ /* 找「確定沒有恐龍」且還沒標 ✕ 的格子 */
  const w=[...G.cells.keys()].filter(i=>!G.cells[i].cat && !G.cells[i].mark && !G.cells[i].revealed);
  return w.length ? w[Math.floor(Math.random()*w.length)] : -1;
}

/* 故事系統 */
let storySeen={}; try{ storySeen=JSON.parse(LS.get('dinodoku-story')||'{}')||{}; }catch(e){}
function storySave(){ LS.set('dinodoku-story', JSON.stringify(storySeen)); }
const STORY = [
  {lv:0, title:'🌟 起源：遠古的黎明', text:'四十六億年前，海洋在雷電中沸騰。帝龍從深淵睜開第一隻眼睛，風神翼龍的祖先第一次飛上天空。鄧氏魚稱霸淺海，奇蝦在寒武紀的浪潮裡游弋，腔棘魚悄悄躲過了大滅絕。遠古的世界，就這樣甦醒了……', cast:[325,301,322,315]},
  {lv:4, title:'帝龍的第一步', text:'火山腳下，一顆蛋輕輕搖動——帝龍破殼而出！梁龍媽媽低下長脖子看著牠，三角龍和劍龍也來打招呼。小帝龍搖搖晃晃站起來，邁出了人生第一步。整個山谷都為牠歡呼！', cast:[325,1,21,11]},
  {lv:5, title:'無齒翼龍的天空', text:'懸崖邊，無齒翼龍教雙脊龍認識風。「飛不起來沒關係，」無齒翼龍說，「每種恐龍都有自己的本事。」始祖鳥撲扇著翅膀掠過——牠是恐龍與鳥類之間的橋樑。天空，屬於勇敢嘗試的傢伙。', cast:[300,91,81]},
  {lv:6, title:'風神翼龍的長征', text:'風神翼龍展開十公尺的翅膀，要飛越整片大陸！南方巨獸龍在地面仰頭大喊：「替我看看世界盡頭！」禽龍們排成一排目送。雲層之上，風神翼龍看見了海洋、雪山，和明天的方向。', cast:[301,111,41]},
  {lv:7, title:'悟空翼龍的雲朵學校', text:'山谷裡開了一間雲朵學校，校長是悟空翼龍！甲龍學防禦，副櫛龍學吹號角。「每個人都不同，」悟空翼龍眨眨眼，「所以每個人都有自己的一課。」下課時，整座山谷都是笑聲。', cast:[310,51,31]},
  {lv:8, title:'奇蝦的寒武紀派對', text:'時光倒流五億年！寒武紀的海底正在開派對：奇蝦揮舞著大鰲當主持人，歐巴賓海蠍用五隻眼睛找零食，怪誕蟲表演倒立行走。「歡迎來到生命大爆發的時代！」海底從來沒這麼熱鬧過。', cast:[315]},
  {lv:9, title:'海口魚的家族相簿', text:'昆明魚和海口魚是人類最古老的祖先！牠們翻開家族相簿：從魚到兩棲類，再到登陸的提塔利克魚。「看，」提塔利克魚指著自己的鰭，「這就是走向陸地的第一步。」原來我們的旅程，從五億年前就開始了。', cast:[318]},
  {lv:10, title:'鄧氏魚的深海對決', text:'泥盆紀的海洋之王鄧氏魚，今天遇到對手了！含肺魚靈活地閃避牠的咬擊，滄龍從遠處游來觀戰。「厲害！」鄧氏魚咬碎了一塊礁石，「不過海洋夠大，我們都可以當王。」三隻巨獸相視而笑。', cast:[322]},
  {lv:11, title:'棘龍王的河流', text:'棘龍王不喜歡別人說牠「不像霸王龍」。「我是游泳高手！」牠一頭扎進河流，抓起一條大魚。食肉牛龍和南方巨獸龍在岸邊看呆了。「看吧，」棘龍王甩甩尾巴，「做自己最帥。」', cast:[324,121,111]},
  {lv:12, title:'滑齒龍的海底迷宮', text:'侏羅紀海底有一座迷宮，滑齒龍是嚮導。上龍和滄龍跟在後面，穿過珊瑚拱門、越過海底峽谷。「傳說迷宮盡頭有寶藏！」到達終點時，大家愣住了——是一面鏡子，映出彼此的笑臉。', cast:[280,278]},
  {lv:13, title:'翼龍三姐妹的飛行大賽', text:'古神翼龍、妖精翼龍、朝陽翼龍，翼龍三姐妹辦了一場飛行大賽！古神翼龍擅長特技，妖精翼龍優雅得像跳舞，朝陽翼龍則一口氣飛了最遠。「冠軍是——」裁判宣布，「一起飛完全程的三姐妹！」', cast:[303,304]},
  {lv:14, title:'帝龍的加冕', text:'世界之巔，帝龍站上遠古王座。風神翼龍、鄧氏魚、棘龍王、霸王龍、滄龍齊聚一堂。「王座不是終點，」帝龍說，「是守護大家的起點。」火山在遠方轟鳴，像在為新王鼓掌。而你——這段遠古傳說的見證者，故事才正要開始！', cast:[325,301,322,324,260]}
];

function openStory(){
  let h='<div class="story-list">'; /* v1.5：修復 const 賦值崩潰 */
  STORY.forEach((s,i)=>{
    const seen = s.lv ? !!storySeen[s.lv] : true;
    const badge = s.lv ? ('LV'+s.lv) : '🌟 起源';
    h+='<div class="story-row"><span class="sr-b">'+badge+(seen?' ✅':'')+'</span><span class="sr-t">'+s.title+'</span><span class="sr-c">'+((s.cast||[]).length+' 位角色')+'</span><button class="btn btn-ghost" onclick="playStory('+i+')">觀看 ▶</button></div>';
  });
  h+='</div>';
  $('game-area').innerHTML=h;
}
function playStory(idx, autoPlay=false){
  const s=STORY[idx];
  if(!s) return;
  const st=$('story-stage');
  st.querySelectorAll('.cast').forEach(e=>e.remove());
  const stt=st.querySelector('.st-title');
  const stb=st.querySelector('.st-body');
  stt.textContent=s.title;
  st.classList.add('show');
  if(autoPlay && s.lv && !storySeen[s.lv]){ storySeen[s.lv]=true; storySave(); }
  /* 角色立繪：隨劇情進度逐一登場 */
  const slots=[{x:'5%',y:'34%',w:'24%'},{x:'34%',y:'24%',w:'30%'},{x:'67%',y:'34%',w:'24%'},{x:'14%',y:'62%',w:'21%'},{x:'54%',y:'62%',w:'21%'}];
  const castEls=(s.cast||[]).map((cid,k)=>{
    const m=MON_BY_ID[cid]; if(!m) return null;
    const d=document.createElement('div');
    d.className='cast';
    d.innerHTML='<img class="p3d" src="'+m.img+'" alt="">';
    const sl=slots[k%slots.length];
    d.style.left=sl.x; d.style.top=sl.y; d.style.width=sl.w; d.style.height='38%';
    d.style.opacity='0'; d.style.transform='translateY(26px) scale(.85)';
    st.appendChild(d);
    return {el:d, at:(k+1)/((s.cast||[]).length+1), name:m.name};
  }).filter(Boolean);
  let i=0; stb.textContent='';
  const shown=new Set();
  const iv=setInterval(()=>{
    stb.textContent+=s.text[i]||'';
    const prog=++i/s.text.length;
    castEls.forEach((c,k)=>{
      if(!shown.has(k) && prog>=c.at){
        shown.add(k);
        c.el.style.opacity='1'; c.el.style.transform='translateY(0) scale(1)';
        SFX.catchp();
      }
    });
    if(i>=s.text.length) clearInterval(iv);
  },28);
  st.onclick=()=>{ clearInterval(iv); st.classList.remove('show'); };
}
$('menu-story').onclick=()=>{ openStory(); show('ov-game'); $('game-title').textContent='🎬 故事'; GAME_BACK_MODE='story'; $('game-again').style.display='none'; SFX.tap(); };
$('story-skip').onclick=e=>{ e.stopPropagation(); $('story-stage').classList.remove('show'); };

/* ---------- 工程模式（隱藏：選單標題連點 5 下） ---------- */
let devTaps=0, devTapT=0;
(function(){
  const t=document.querySelector('#ov-menu .menu-title');
  if(!t) return;
  t.style.cursor='pointer'; t.style.userSelect='none';
  t.addEventListener('click',()=>{
    const now=Date.now();
    if(now-devTapT>3000) devTaps=0;
    devTapT=now;
    if(++devTaps>=5){ devTaps=0; openDev(); }
  });
})();
function openDev(){
  const bm=BUDDY.id && MON_BY_ID[BUDDY.id] ? MON_BY_ID[BUDDY.id].name : '無';
  const df=!!ECON.devFree;
  $('dev-info').innerHTML='🌌 '+(df?'∞':(ECON.seeds||0))+' · 🎟 '+(df?'∞':(ECON.tickets||0))+' · 圖鑑 '+dexGot.size+'/'+allMons().length+' · 🐾 '+bm+(df?' · <b style="color:#06a57d">DEV 無限模式</b>':'');
  const db=$('dev-free');
  if(db){ db.textContent='∞ 無限種子：'+(df?'開':'關'); db.style.color=df?'#06a57d':''; }
  const da=$('dev-dex-all');
  if(da){ const done=dexGot.size>=allMons().length; da.disabled=done; da.textContent=done?'📖 全圖鑑已開啟':'📖 開啟全圖鑑'; }
  const sel=$('dev-lv'); sel.innerHTML='';
  for(let n=4;n<=14;n++){
    const o=document.createElement('option');
    o.value=n;
    o.textContent = n===4?'4 示範':(n===5?'5 引導':'LV'+n);
    sel.appendChild(o);
  }
  show('ov-dev'); SFX.tap();
}
$('dev-close').onclick=()=>hide('ov-dev');
$('dev-win').onclick=()=>{
  if(!G || G.tutorial || G.state!=='marking'){ floatText($('ov-dev'),'目前無進行中的關卡','#d64545'); return; }
  hide('ov-dev');
  G.cells.forEach((c,i)=>{ if(c.cat && !c.revealed){ c.revealed=true; cellEls[i].classList.add('alive'); } });
  G.found=G.N; updateHUD(); updateStatus();
  G.state='ending'; timerStop();
  setTimeout(winRound,600);
};
$('dev-seeds').onclick=()=>{ ECON.seeds=(ECON.seeds||0)+100; econSave(); econRender(); refreshBest(); openDev(); };
$('dev-tickets').onclick=()=>{ ECON.tickets=(ECON.tickets||0)+10; econSave(); econRender(); refreshBest(); openDev(); };
$('dev-jump').onclick=()=>{ const n=+$('dev-lv').value; if(!n||n<4||n>14) return; hide('ov-dev'); hide('ov-menu'); newRun(n); };
$('dev-free').onclick=()=>{ ECON.devFree=!ECON.devFree; econSave(); econRender(); refreshBest(); openDev(); };
$('dev-reward').onclick=()=>{ hide('ov-dev'); econRender(); show('ov-reward'); SFX.tap(); };
$('dev-dex-all').onclick=()=>{
  dexGot=new Set(allMons().map(p=>p.id));
  LS.set('dinodoku-dex', JSON.stringify([...dexGot]));
  renderDex();
  openDev();
  floatText($('ov-dev'),'全圖鑑已開啟：'+dexGot.size+' / '+allMons().length,'#06a57d');
};
$('dlg-feed').onclick=(e)=>{ e.stopPropagation(); feedBuddy(); };
$('dev-feed').onclick=()=>{
  if(!BUDDY.id){ floatText($('ov-dev'),'尚未設定隨行恐龍（圖鑑→點恐龍→設為隨行）','#d64545'); return; }
  frGain(BUDDY.id,10);
  doBuddyChat('好吃！😊 謝謝你～<b>♥ '+frOf(BUDDY.id)+'%</b>');
  openDev();
  floatText($('ov-dev'),'🍖 '+MON_BY_ID[BUDDY.id].name+' 友好度 '+frOf(BUDDY.id)+'%','#06a57d');
};
$('dev-skill').onclick=()=>{
  if(!BUDDY.id){ floatText($('ov-dev'),'尚未設定隨行恐龍','#d64545'); return; }
  if(!G || G.state!=='marking' || G.tutorial){ floatText($('ov-dev'),'需在關卡標記階段才能測試','#d64545'); return; }
  if(!buddySkillList().length){ floatText($('ov-dev'),'這隻恐龍目前沒有技能','#d64545'); return; }
  hide('ov-dev');
  setTimeout(()=>triggerBuddySkill(),350);
};
$('dev-wipe').onclick=()=>{
  if(!confirm('清除所有存檔？（分數／圖鑑／種子／技能／隨行全部重置）')) return;
  ['dinodoku-dex','dinodoku-sound','dinodoku-lv','dinodoku-econ','dinodoku-skills','dinodoku-potential','dinodoku-buddy','dinodoku-friend','dinodoku-friend2','dinodoku-story'].forEach(k=>{ try{ localStorage.removeItem(k); }catch(e){} });
  location.reload();
};

/* 過關時友好度、潛能值與故事獎勵 */
const OLD_WINROUND = winRound;
winRound = function(){
  const oldArgs=arguments;
  ECON.streak=(ECON.streak||0)+1; econSave();
  G.potentialReward=null;
  if(BUDDY.id && G && G.N>=4){
    frGain(BUDDY.id, 5);
    const gained=potentialGain(BUDDY.id, POTENTIAL_PER_WIN);
    if(gained>0){
      G.potentialReward={gain:gained,value:potentialOf(BUDDY.id)};
      if(G.potentialReward.value===100) doBuddyChat('潛能已經蓄滿！可以到圖鑑重塑技能了！<b>⚡ 100/100</b>');
    }
  }
  const storyIdx=G && G.N>=4 && !storySeen[G.N] ? STORY.findIndex(s=>s.lv===G.N) : -1;
  const result=OLD_WINROUND.apply(this, oldArgs);
  if(storyIdx>=0){
    setTimeout(()=>{ if(!storySeen[STORY[storyIdx].lv]) playStory(storyIdx, true); }, 0);
  }
  return result;
};


/* ---------- 遊戲狀態 ---------- */
let G = null;
let cellEls = [];
let demoToken = 0;
const TUT = { expect:null };

function newRun(N){
  G = { N, round:1, lastFail:false, nextMode:null,
        tutorial: N===4?'demo':(N===5?'guided':null) };
  startBuddyTimers();
  newBoard();
}

function newBoard(){
  const N = G.N;
  if(N>=10){
    const ro = poolTake(N);
    if(ro){
      const sol = N>=16 ? solve2(N, ro, 500000, 5) : solve2(N, ro);
      if(sol && sol.length>=1 && (N>=16 ? sol.length<=4 : sol.length===1)){
        const cats=new Set(); for(let r=0;r<N;r++) cats.add(r*N+sol[0][r]);
        finishBoard({cats, regionOf:ro, allSols: N>=16 ? sol : null});
        poolRefill();
        return;
      }
    }
  }
  $('gen-what').textContent = N+' × '+N+(G.tutorial?' 教學盤':' 唯一解盤面');
  show('ov-loading');
  setTimeout(()=>{
    let pz=null;
    if(N>=14){ pz=generatePuzzle(N,8000); }
    else { for(const b of [1200,3000,8000]){ pz=generatePuzzle(N,b); if(pz) break; } }
    hide('ov-loading');
    if(pz){ finishBoard(pz); poolRefill(); }
    else {
      G.state='done';
      const sub=$('genfail-sub');
      if(sub){ sub.textContent = N>=14 ? '大盤面的唯一解需要點運氣，建議重試一次，或先玩較小的盤面～' : '這次運氣不好，再試一次？'; }
      show('ov-genfail');
    }
  }, 60);
}

function finishBoard(pz){
  const N = G.N;
  G.cats = pz.cats; G.regionOf = pz.regionOf;
  /* 多解盤：全部解的星格並集（點中任一解的星都算貓） */
  G.catUnion = new Set();
  if(pz.allSols && pz.allSols.length){
    pz.allSols.forEach(s=>{ for(let r=0;r<N;r++) G.catUnion.add(r*N+s[r]); });
  } else { pz.cats.forEach(i=>G.catUnion.add(i)); }
  G.cells = [];
  for(let i=0;i<N*N;i++) G.cells.push({ cat: pz.cats.has(i), region: pz.regionOf[i], mark:'' });
  /* v1.2.1：加權不放回抽樣（整體機率 1★>2★>3★>4★>5★；出沒區域 ×4；4×4/5×5 僅 2★以下） */
  (function(){
    const need=Math.max(N, G.catUnion.size);
    const maxStars=(N<=5)?2:5;
    let cand=allMons().filter(p=>(p.stars||1)<=maxStars);
    const picked=[];
    for(let k=0;k<need && cand.length;k++){
      const m=wpick(cand, p=>spawnWeight(p,N));
      picked.push(m);
      cand=cand.filter(p=>p.id!==m.id);
    }
    if(picked.length<need){
      const ids=new Set(picked.map(p=>p.id));
      const extra=shuffle([...POKEMON]).filter(p=>!ids.has(p.id));
      while(picked.length<need && extra.length) picked.push(extra.shift());
    }
    [...G.catUnion].sort((a,b)=>a-b).forEach((ci,k)=>{ G.cells[ci].poke = picked[k]; });
  })();
  G.chests=[]; G.caughtMons=[];
  if(!G.tutorial) placeChests();
  G.state='marking'; G.balls=N+3; G.ballMode=false; G.found=0; G.lastFail=false; /* v1.3：隻數+3 容錯 */
  if(typeof updateHintBtn==='function') updateHintBtn();
  G.colors = assignRegionColors(N, G.regionOf, buildPalette(N));
  renderBoard();
  $('btn-clear').disabled=!!G.tutorial;
  $('btn-ball').disabled=false; $('btn-ball').classList.remove('active'); $('ball-n').textContent='×'+G.balls;
  document.body.classList.remove('ball-mode');
  timerStart();
  updateHUD(); updateStatus(); renderLV();
  demoToken++;
  tutHide();
  if(G.tutorial==='demo') startDemo();
  else if(G.tutorial==='guided') startGuided();
}

function renderBoard(){
  const N=G.N;
  const board=$('board'), cc=$('colcounts'), rc=$('rowcounts');
  board.innerHTML=''; cc.innerHTML=''; rc.innerHTML='';
  /* v2.1：13/14 也用 1fr 自適應（縮小方格，取消捲動） */
  board.style.width = cc.style.width = '';
  board.style.gridTemplateColumns = 'repeat('+N+',1fr)';
  cc.style.gridTemplateColumns = 'repeat('+N+',1fr)';
  rc.style.gridTemplateRows = 'repeat('+N+',1fr)';
  cellEls = [];
  for(let i=0;i<N*N;i++){
    const d=document.createElement('div');
    d.className='cell'+(G.cells[i].poke?(' st'+(G.cells[i].poke.stars||1)):'');
    d.style.background = G.colors[G.cells[i].region];
    d.innerHTML = '<span class="mk">✕</span>'
      +(G.cells[i].chest?'<span class="chesthide">'+chestSvgFor(G.cells[i].chest)+'</span>':'')
      +'<span class="catface"><span class="p3d"><img alt="" draggable="false"></span></span>';
    const im=d.querySelector('.catface img');
    if(G.cells[i].poke) im.src = G.cells[i].poke.img;
    d.addEventListener('click', ()=>onCell(i));
    board.appendChild(d); cellEls.push(d);
  }
  for(let c=0;c<N;c++){ const s=document.createElement('span'); s.textContent=c+1; cc.appendChild(s); }
  for(let r=0;r<N;r++){ const s=document.createElement('span'); s.textContent=r+1; rc.appendChild(s); }
  sizeFont();
  syncDexSize();
}
function syncDexSize(){ /* 圖鑑圖示固定＝6×6 時的方格尺寸（上限 92px）；v1.2.1 扣除面板內距 */
  const w = $('board-area').clientWidth;
  const base = (w ? w : 464) - 24;
  const px = Math.min(92, Math.floor((base - 5*5) / 6));
  document.documentElement.style.setProperty('--dexpx', px+'px');
}
function sizeFont(){
  const board=$('board');
  const px = Math.max(20, board.clientWidth / G.N);
  board.style.fontSize = Math.max(8, Math.floor(px*0.5)) + 'px';
}
window.addEventListener('resize', ()=>{ if(G && cellEls.length){ sizeFont(); syncDexSize(); } });

/* ---------- 偽 3D 傾斜引擎：所有 .p3d 元素隨指標傾斜＋動態光影（全域事件委派） ---------- */
(function(){
  const MAX=16, PERSP=520, LIFT=10;
  let cur=null;
  function light(rx,ry){ const f=Math.max(-1,Math.min(1,(-rx*0.8+ry*0.6)/MAX)); return (1+f*0.09).toFixed(3); }
  function move(e){
    const t=e.target&&e.target.closest?e.target.closest('.p3d'):null;
    if(cur&&cur!==t) reset(cur);
    if(!t) return;
    const r=t.getBoundingClientRect();
    if(!r.width||!r.height) return;
    const px=(e.clientX-r.left)/r.width, py=(e.clientY-r.top)/r.height;
    if(px<-0.3||px>1.3||py<-0.3||py>1.3) return;
    const ry=(px-0.5)*2*MAX, rx=-(py-0.5)*2*MAX;
    if(cur!==t){ t.style.transition='transform .06s linear'; cur=t; }
    t.style.transform='perspective('+PERSP+'px) rotateX('+rx.toFixed(2)+'deg) rotateY('+ry.toFixed(2)+'deg) translateZ('+LIFT+'px) scale(1.05)';
    t.style.filter='brightness('+light(rx,ry)+') drop-shadow('+(-ry*0.45).toFixed(1)+'px '+(6+Math.abs(rx)*0.25).toFixed(1)+'px 7px rgba(0,0,0,.26))';
  }
  function reset(t){
    if(cur===t) cur=null;
    t.style.transition='transform .45s cubic-bezier(.2,1.5,.4,1), filter .4s ease';
    t.style.transform=''; t.style.filter='';
  }
  document.addEventListener('pointermove',move,{passive:true});
  document.addEventListener('pointerout',e=>{
    const t=e.target&&e.target.closest?e.target.closest('.p3d'):null;
    if(t&&!(e.relatedTarget&&e.relatedTarget.closest&&e.relatedTarget.closest('.p3d')===t)) reset(t);
  },{passive:true});
  document.addEventListener('pointercancel',e=>{ const t=e.target&&e.target.closest?e.target.closest('.p3d'):null; if(t) reset(t); },{passive:true});
  window.addEventListener('blur',()=>{ if(cur) reset(cur); });
  document.addEventListener('scroll',()=>{ if(cur) reset(cur); },true);
})();

function neighbors8(i,N){
  const r=Math.floor(i/N), c=i%N, out=[];
  for(let dr=-1;dr<=1;dr++)for(let dc=-1;dc<=1;dc++){
    if(!dr&&!dc) continue;
    const rr=r+dr, cc=c+dc;
    if(rr>=0&&rr<N&&cc>=0&&cc<N) out.push(rr*N+cc);
  }
  return out;
}
function markToggle(i){
  const c=G.cells[i];
  c.mark = (c.mark==='x') ? '' : 'x';
  cellEls[i].classList.toggle('x', c.mark==='x');
  (c.mark==='x'?SFX.tap:SFX.untap)();
  updateStatus();
}
function setBallMode(on){
  G.ballMode=on;
  document.body.classList.toggle('ball-mode', on);
  $('btn-ball').classList.toggle('active', on);
  updateStatus();
}
function doBall(i){
  if(G.balls<=0) return;
  const c=G.cells[i];
  if(c.revealed) return;
  G.balls--;
  SFX.ball();
  const el=cellEls[i];
  if(c.cat || G.catUnion.has(i)){
    c.revealed=true; c.mark='';
    el.classList.remove('x');
    G.found++;
    if(c.poke) G.caughtMons.push(c.poke);
    el.classList.add('cat');
    const isNew = c.poke ? dexCollect(c.poke.id) : false;
    const isFive = !!(c.poke && c.poke.stars===5);
    if(isNew) spawnCatchText(el, isFive);
    if(isNew && !G.tutorial && c.poke){ /* 新發現：等寵物落到格子後彈出星空發現視窗 */
      const mm=c.poke, gg=G;
      setTimeout(()=>{ if(G===gg) queueNewMon(mm); }, isFive?4250:2150);
    }
  if(isFive){

    confetti();

    SFX.win();
}
    SFX.catchp();
    if(!G.tutorial && TIMER.on){
      timerAdd(30);
      setTimeout(()=>floatText(el,'+30s ⏱','#1f7a46'), 380);
    }
    updateStatus();
    /* 滿好感（100%）加成：捕獲後自動排除同行同列（邏輯必然安全） */
    if(!G.tutorial && BUDDY.id && frOf(BUDDY.id)>=100){
      const curG=G;
      const N=G.N, rr=Math.floor(i/N), cc2=i%N;
      const tset=new Set();
      for(let c3=0;c3<N;c3++){ if(rr*N+c3!==i) tset.add(rr*N+c3); }
      for(let r3=0;r3<N;r3++){ if(r3*N+cc2!==i) tset.add(r3*N+cc2); }
      for(const nb of neighbors8(i,N)) tset.add(nb); /* 周圍八格（含斜角）也安全 */
      const targets=[...tset].filter(j=>!curG.cells[j].mark && !curG.cells[j].revealed);
      const animMs = isFive?4200:2200; /* 等恐龍出現動畫結束 */
      targets.forEach((j,k)=>{
        setTimeout(()=>{
          if(G===curG && G.state==='marking' && !curG.cells[j].mark && !curG.cells[j].revealed){
            curG.cells[j].mark='x';
            cellEls[j].classList.add('x');
            SFX.tap();
            updateStatus();
          }
        }, animMs + k*200);
      });
      if(targets.length) doBuddyChat('滿滿的羈絆！這行、這列和周圍我都幫你排除了 ✕');
    }
  } else if(c.chest && !c.chestGot){
    c.chestGot=true; c.mark='';
    el.classList.remove('x');
    G.chests.push(c.chest);
    el.classList.add('chestgot');
    floatText(el,'發現寶箱！','#b8860b');
    SFX.bonus();
    updateStatus();
  } else {
    c.mark='x';
    el.classList.add('x','missflash');
    setTimeout(()=>el.classList.remove('missflash'),600);
    floatText(el,'落空','#8a7d6f');
    SFX.miss();
    updateStatus();
  }
  if(G.balls<=0) setBallMode(false);
  $('ball-n').textContent='×'+G.balls;
  checkBallEnd();
}

function onCell(i){
  if(!G || G.state!=='marking') return;
  if(TUT.expect){
    if(TUT.expect.type==='cell' && TUT.expect.cells.has(i)){
      const f=TUT.expect.fn; clearExpect(); f(i);
    } else tutNudge();
    return;
  }
  if(G.ballMode && G.balls>0){ doBall(i); return; }
  markToggle(i);
}

function updateCounts(){ /* 座標為靜態標籤 1..N，無需更新 */ }

function updateStatus(){
  const cand = G.cells.filter(c=>c.mark!=='x').length;
  const okk = cand===G.N ? ' ✅' : '';
  $('status').innerHTML = '候選 <b>'+cand+'</b> 格 · 恐龍 <b>'+G.N+'</b> 隻 · 已排除 <b>'+(G.cells.length-cand)+'</b> 格'+okk+(G.ballMode?' · 🎯 <b>捕捉器模式：點方格捕獲</b>':'');
}

function updateHUD(){
  $('round').textContent = G.round;
  $('score').textContent = lvTotal();
  renderHearts();
}
function renderHearts(){
  const el=$('hearts');
  while(el.children.length<3){ const s=document.createElement('span'); s.className='hrt'; s.textContent='❤️'; el.appendChild(s); }
}

/* ---------- 沙漏計時器 ---------- */
const TIMER = { total:0, left:0, on:false, iv:null, last:0, el:0, lastWhole:-1 };
function timerPaused(){
  return document.hidden || !!document.querySelector('.overlay.show');
}
function timerStart(){
  if(G.tutorial){ $('hud-timer').style.display='none'; TIMER.on=false; return; }
  TIMER.total=G.N*30; TIMER.left=TIMER.total; TIMER.el=0; TIMER.on=true; TIMER.lastWhole=-1;
  TIMER.last=performance.now();
  $('hud-timer').style.display='inline-flex';
  $('hud-timer').classList.remove('hg-danger','hg-crit');
  if(!TIMER.iv) TIMER.iv=setInterval(timerTick,200);
  renderTimer();
}
function timerStop(){ TIMER.on=false; }
function timerTick(){
  if(!TIMER.on) return;
  const now=performance.now();
  if(!timerPaused()) TIMER.left -= (now-TIMER.last)/1000;
  TIMER.last=now;
  if(TIMER.left<=0){ TIMER.left=0; renderTimer(); timeUp(); return; }
  renderTimer();
}
function timerAdd(sec){
  if(!TIMER.on) return;
  TIMER.left=Math.min(TIMER.total, TIMER.left+sec);
  SFX.bonus();
  const h=$('hud-timer');
  h.classList.remove('hg-pulse'); void h.offsetWidth; h.classList.add('hg-pulse');
  floatText(h, '+'+sec+'s', '#1f7a46');
  renderTimer();
}
function fmtTime(s){ s=Math.ceil(s); return Math.floor(s/60)+':'+String(s%60).padStart(2,'0'); }
function renderTimer(){
  if(!TIMER.on && TIMER.left<=0) return;
  const f=Math.max(0, Math.min(1, TIMER.left/TIMER.total));
  TIMER.el=Math.max(TIMER.el, 1-f);
  $('time-text').textContent=fmtTime(TIMER.left);
  const topClip=$('clipTop'), botClip=$('clipBot'), stream=$('hg-stream');
  const th=11*f; topClip.setAttribute('y', String(15-th)); topClip.setAttribute('height', String(th));
  const bh=10.6*TIMER.el; botClip.setAttribute('y', String(27.6-bh)); botClip.setAttribute('height', String(bh));
  const flowing = TIMER.on && !timerPaused() && f>0.002 && TIMER.el<0.998;
  stream.style.opacity = flowing ? 1 : 0;
  const h=$('hud-timer');
  h.classList.toggle('hg-danger', TIMER.left<=60 && TIMER.on);
  h.classList.toggle('hg-crit', TIMER.left<=10 && TIMER.on);
  const w=Math.floor(TIMER.left);
  if(TIMER.on && TIMER.left<=10 && TIMER.left>0 && w!==TIMER.lastWhole){ TIMER.lastWhole=w; SFX.tick(); }
}
function timeUp(){
  if(!G || G.state!=='marking') return;
  timerStop(); G.state='ending';
  G.cells.forEach((c,i)=>{ if(c.cat && !c.revealed && c.mark!=='x') cellEls[i].classList.add('ghost'); });
  SFX.fail();
  setTimeout(timeoutRound, 900);
}
function timeoutRound(){
  G.state='done'; G.lastFail=true;
  ECON.streak=0; econSave();
  const chests=chestRollAll();
  const left=G.N-G.found;
  $('res-emoji').textContent='⏰';
  $('res-title').textContent='時間到！';
  $('res-sub').textContent='沙漏的沙流光了…還有 '+left+' 隻恐龍沒找到（位置已揭示）';
  let bd='';
  bd+=row('🎯 捕獲恐龍', G.found+' / '+G.N, '+0', '');
  bd+=chests.rows;
  bd+='<div class="row" style="border-top:1px dashed #ddd0ba;margin-top:6px;padding-top:6px"><span><b>個人總分</b></span><span><b>'+fmtSec(lvTotal())+'</b></span></div>';
  $('res-breakdown').innerHTML=bd;
  $('res-next').textContent='再挑戰一局';
  setupResSel();
  show('ov-result');
  chestStripAnimate(chests.list, G.caughtMons);
}

