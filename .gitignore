# Node / build artifacts (regenerate with `npm install` + `npm run sync`)
node_modules/
working_db/builds/dist/

# Capacitor synced web bundle (regenerated by `npx cap sync ios`)
ios/App/App/public/

# Python caches
__pycache__/
*.pyc

# Backups (historical backups already tracked stay in the repo)
*.bak*
index_backup_*.html

# Single-file release bundles (retired; not kept in the repo)
dragonfinder_v*.html

# API keys (local only, never commit)
working_db/generated_assets/dinos_2/bban_samples/_gemini_key*.txt
working_db/generated_assets/dinos_2/bban_samples/_sophnet_key.txt

# Pipeline intermediates (raw generations and heavy scratch) stay local
